#!/bin/sh
set -eu

# tags: #pkg

sudo xbps-install -Sy \
    cups \
    cups-filters \
    cups-browsed \
    hplip \
    hplip-gui

sudo ln -sfn /etc/sv/cupsd /var/service/cupsd
sudo ln -sfn /etc/sv/cups-browsed /var/service/cups-browsed

sudo usermod -aG lp,lpadmin "$USER"

sudo sv up cupsd
sudo sv up cups-browsed

echo "Printer services are running. Log out and back in for group changes to apply."
echo "Open CUPS at http://localhost:631 or run hp-setup for HP printers."
