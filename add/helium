#!/bin/bash

set -euo pipefail

tmp_dir="/tmp/helium-install"
rm -rf "$tmp_dir"
mkdir -p "$tmp_dir"
trap 'rm -rf "$tmp_dir"' EXIT

api_url="https://api.github.com/repos/imputnet/helium-linux/releases/latest"
release_json="$tmp_dir/release.json"

curl -fsSL "$api_url" -o "$release_json"

asset_info="$(python3 - "$release_json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as release_file:
    release = json.load(release_file)

for asset in release.get("assets", []):
    name = asset.get("name", "")
    if name.endswith("-x86_64.AppImage"):
        print(asset.get("browser_download_url", ""))
        print(name)
        break
else:
    raise SystemExit("Could not find x86_64 AppImage in latest release")
PY
)"

mapfile -t asset_lines <<< "$asset_info"
appimage_url="${asset_lines[0]:-}"
appimage_name="${asset_lines[1]:-}"
appimage_path="$tmp_dir/$appimage_name"

if [[ -z "$appimage_url" || -z "$appimage_name" ]]; then
  echo "Failed to extract AppImage download details." >&2
  exit 1
fi

curl -fL "$appimage_url" -o "$appimage_path"
chmod +x "$appimage_path"

sudo mv "$appimage_path" /opt/helium.AppImage
sudo ln -sf /opt/helium.AppImage /usr/local/bin/helium

echo "Installed Helium browser"
