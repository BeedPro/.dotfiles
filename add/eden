#!/usr/bin/env bash
set -euo pipefail

# tags: #pkg

sudo xbps-install -Sy curl

VERSION="0.2.1"
APPIMAGE="Eden-Linux-v${VERSION}-amd64-clang-pgo.AppImage"
CHECKSUM="7a28bf988b0648831989722bdbaa90ab31371b403808199813e0ea7c8b25ba6d"
INSTALL_DIR="/opt"
BIN_LINK="/usr/local/bin/eden"
URL="https://stable.eden-emu.dev/v${VERSION}/${APPIMAGE}"
TARGET_BIN="${INSTALL_DIR}/${APPIMAGE}"

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

cd "$TMP_DIR"

curl -fL -o "$APPIMAGE" "$URL"
printf '%s  %s\n' "$CHECKSUM" "$APPIMAGE" | sha256sum --check

sudo rm -f "$TARGET_BIN"
sudo mv "$APPIMAGE" "$TARGET_BIN"
sudo chmod +x "$TARGET_BIN"

sudo ln -sfn "$TARGET_BIN" "$BIN_LINK"

echo "Eden installed: $BIN_LINK -> $TARGET_BIN"
