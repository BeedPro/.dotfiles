#!/bin/bash

set -euo pipefail

SRC_PATH="$HOME/.local/src/vial-kb/vial-qmk"

printf "[vial-qmk] Installing build dependencies...\n"
sudo apt-get update
sudo apt-get install -y \
  gcc-arm-none-eabi \
  binutils-arm-none-eabi \
  libnewlib-arm-none-eabi \
  dfu-util \
  dfu-programmer

printf "[vial-qmk] Preparing source directory: %s\n" "$SRC_PATH"
mkdir -p "$(dirname "$SRC_PATH")"

if [ -d "$SRC_PATH/.git" ]; then
  printf "[vial-qmk] Repo exists, pulling latest changes...\n"
  git -C "$SRC_PATH" pull --ff-only
else
  printf "[vial-qmk] Cloning Vial QMK...\n"
  git clone https://github.com/vial-kb/vial-qmk "$SRC_PATH"
fi

printf "[vial-qmk] Syncing git submodules...\n"
make -C "$SRC_PATH" git-submodule

printf "[vial-qmk] Installing QMK CLI (if not already installed)...\n"
curl -fsSL https://install.qmk.fm | sh

printf "[vial-qmk] Registering firmware path with QMK CLI...\n"
qmk setup -H "$SRC_PATH" -y

printf "\n[vial-qmk] Setup complete.\n"
printf "You can now build firmware with:\n"
printf "  cd %s\n" "$SRC_PATH"
printf "  make keychron/v4/iso:vial\n"
printf "  make crkbd/rev4:vial\n"
printf "\nTo flash your keyboard:\n"
printf "  make keychron/v4/iso:vial:flash\n"
printf "  make crkbd/rev4:vial:flash\n"

printf "\nCorne (crkbd) rev4 firmware notes:\n"
printf "  https://github.com/foostan/crkbd/blob/main/docs/firmware/rev4/firmware_en.md\n"

KEYBOARDS_DIR="$SRC_PATH/keyboards"
TARGET_KEYBOARD_DIR="$SRC_PATH/keyboards/keychron/v4"

if [ -d "$KEYBOARDS_DIR" ]; then
  printf "\n----- keyboards directory (top level) -----\n"
  ls -1 "$KEYBOARDS_DIR"
fi

if [ -d "$TARGET_KEYBOARD_DIR" ]; then
  printf "\n----- keychron/v4 directory contents -----\n"
  ls -1 "$TARGET_KEYBOARD_DIR"
else
  printf "\n[vial-qmk] Could not find keyboard directory: %s\n" "$TARGET_KEYBOARD_DIR"
fi

README_PATH="$SRC_PATH/keyboards/keychron/v4/readme.md"
if [ ! -f "$README_PATH" ]; then
  README_PATH="$SRC_PATH/keyboards/keychron/v4/README.md"
fi

if [ -f "$README_PATH" ]; then
  printf "\n----- keychron/v4 README -----\n"
  cat "$README_PATH"
  printf "\n----- end README -----\n"
else
  printf "\n[vial-qmk] Could not find keychron/v4 README in the repo.\n"
fi
