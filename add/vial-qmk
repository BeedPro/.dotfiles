#!/bin/bash

# README:
# This script installs dependencies and sets up a local clone of Vial QMK at:
#   $HOME/.local/src/vial-kb/vial-qmk
#
# What it does:
# 1) Installs ARM/QMK-related packages with apt
# 2) Clones (or updates) the vial-qmk repository
# 3) Syncs git submodules
# 4) Installs QMK CLI
# 5) Registers the repo with QMK CLI
#
# Build examples:
#   cd $HOME/.local/src/vial-kb/vial-qmk
#   make keychron/v4/iso:vial
#   make crkbd/rev4:vial
#
# Flash examples:
#   make keychron/v4/iso:vial:flash
#   make crkbd/rev4:vial:flash
#
# Corne (crkbd) rev4 firmware notes:
#   https://github.com/foostan/crkbd/blob/main/docs/firmware/rev4/firmware_en.md
#   https://github.com/vial-kb/vial-qmk/tree/vial/keyboards/crkbd
#
# Vial-only udev setup (run manually if Vial cannot detect your keyboard):
#   export USER_GID=$(id -g)
#   sudo --preserve-env=USER_GID sh -c 'echo "KERNEL==\"hidraw*\", SUBSYSTEM==\"hidraw\", ATTRS{serial}==\"*vial:f64c2b3c*\", MODE=\"0660\", GROUP=\"$USER_GID\", TAG+=\"uaccess\", TAG+=\"udev-acl\"" > /etc/udev/rules.d/59-vial.rules'
#   sudo rm -f /etc/udev/rules.d/99-vial.rules /etc/udev/rules.d/92-viia.rules
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Notes:
# - Replug keyboard after reloading udev rules.
# - Restart the Vial app after applying rules.

set -euo pipefail

SRC_PATH="$HOME/.local/src/vial-kb/vial-qmk"

printf "[vial-qmk] For setup notes (including Vial udev), read this script header: %s\n\n" "$0"

printf "[vial-qmk] Installing build dependencies...\n"
sudo apt-get update
sudo apt-get install -y \
  gcc-arm-none-eabi \
  binutils-arm-none-eabi \
  libnewlib-arm-none-eabi \
  dfu-util \
  dfu-programmer

printf "[vial-qmk] Preparing source directory: %s\n" "$SRC_PATH"
mkdir -p "$(dirname "$SRC_PATH")"

if [ -d "$SRC_PATH/.git" ]; then
  printf "[vial-qmk] Repo exists, pulling latest changes...\n"
  git -C "$SRC_PATH" pull --ff-only
else
  printf "[vial-qmk] Cloning Vial QMK...\n"
  git clone https://github.com/vial-kb/vial-qmk "$SRC_PATH"
fi

printf "[vial-qmk] Syncing git submodules...\n"
make -C "$SRC_PATH" git-submodule

printf "[vial-qmk] Installing QMK CLI (if not already installed)...\n"
curl -fsSL https://install.qmk.fm | sh

printf "[vial-qmk] Registering firmware path with QMK CLI...\n"
qmk setup -H "$SRC_PATH" -y

printf "\n[vial-qmk] Setup complete. Read this script header for usage/build/flash notes: %s\n" "$0"
