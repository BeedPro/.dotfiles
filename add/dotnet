#!/usr/bin/env bash
set -euo pipefail

# tags: #dev

VERSION="10.0.302"
ARCHIVE="dotnet-sdk-${VERSION}-linux-x64.tar.gz"
CHECKSUM="10069bec8783596484a610332f090d562802a41b9b40e3327a5a5688b572e10c296ae300f940d40461f23c157ed1b0843c2f8e6b3f20d8d8d9d83432d8143bac"
URL="https://builds.dotnet.microsoft.com/dotnet/Sdk/${VERSION}/${ARCHIVE}"
INSTALL_DIR="${DOTNET_INSTALL_DIR:-$HOME/.dotnet}"

sudo xbps-install -Sy curl

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

cd "$TMP_DIR"

curl -fL -o "$ARCHIVE" "$URL"
printf '%s  %s\n' "$CHECKSUM" "$ARCHIVE" | sha512sum --check

mkdir -p "$INSTALL_DIR"
tar -xzf "$ARCHIVE" -C "$INSTALL_DIR"
mkdir -p "$HOME/.local/bin"
ln -sfn "$INSTALL_DIR/dotnet" "$HOME/.local/bin/dotnet"

echo "dotnet installed: $INSTALL_DIR/dotnet"
