#!/usr/bin/env bash
set -euo pipefail

sudo xbps-install -Syu

sudo xbps-install -Sy \
    unzip \
    speech-dispatcher \
    ncurses-term \
    bash-completion \
    brightnessctl \
    stow \
    fd \
    ripgrep \
    dust \
    eza \
    bat \
    git-lfs \
    python3-pipx \
    curl \
    fzf \
    tmux \
    qalculate \
    flatpak

# TODO: Add espanso

sudo xbps-install -Sy \
    qalculate-gtk \
    scrcpy \
    gucharmap \
    syncthing \
    timeshift \
    keepassxc \
    zathura \
    nsxiv \
    calibre \
    rofi

bat cache --build
flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo

git clone --depth=1 https://github.com/void-linux/void-packages.git ~/.local/pkgs
cd ~/.local/pkgs
~/.local/pkgs/xbps-src binary-bootstrap

sudo reboot
