#!/usr/bin/env bash
set -euo pipefail

sudo xbps-install -Syu

sudo xbps-install -Sy \
    xtools \
    unzip \
    speech-dispatcher \
    ncurses-term \
    bash-completion \
    brightnessctl \
    stow \
    fd \
    ripgrep \
    dust \
    eza \
    bat \
    git-lfs \
    python3-pipx \
    curl \
    wget \
    fzf \
    tmux \
    qalculate \
    flatpak

wget -O /tmp/Espanso-X11.AppImage 'https://github.com/espanso/espanso/releases/latest/download/Espanso-X11.AppImage'
chmod u+x /tmp/Espanso-X11.AppImage
sudo mv /tmp/Espanso-X11.AppImage /opt
sudo ln -sf /opt/Espanso-X11.AppImage /usr/local/bin/espanso-x11

sudo xbps-install -Sy \
    qalculate-gtk \
    scrcpy \
    gucharmap \
    syncthing \
    timeshift \
    keepassxc \
    zathura \
    nsxiv \
    calibre \
    mpv \
    mpd \
    rofi

bat cache --build
flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo

git clone --depth=1 https://github.com/void-linux/void-packages.git ~/.local/pkgs
cd ~/.local/pkgs
~/.local/pkgs/xbps-src binary-bootstrap

sudo reboot
