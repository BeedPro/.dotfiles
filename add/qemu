#!/usr/bin/env bash
set -euo pipefail

if ! grep -Eq '(vmx|svm)' /proc/cpuinfo; then
  echo "CPU virtualization extensions not detected (vmx/svm)." >&2
  exit 1
fi

sudo apt update
sudo apt install -y qemu-kvm qemu-system qemu-utils python3 python3-pip libvirt-clients libvirt-daemon-system bridge-utils virtinst libvirt-daemon virt-manager

sudo systemctl enable --now libvirtd.service
sudo virsh net-autostart default
sudo virsh net-start default || true

for group in libvirt libvirt-qemu kvm input disk; do
  if id -nG "$USER" | tr ' ' '\n' | grep -qx "$group"; then
    continue
  fi

  sudo usermod -aG "$group" "$USER"
done

echo "QEMU/libvirt configured. Log out and back in for new group memberships to apply."
