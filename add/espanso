#!/bin/sh
set -eu

# tags: #pkg

sudo xbps-install -Sy curl

VERSION="2.3.0"
APPIMAGE="Espanso-X11.AppImage"
CHECKSUM="b0ce546786f6a54b31e0a30df0a797804fadf0a89b5b189ea115d25cb410866c"
INSTALL_DIR="/opt"
BIN_LINK="/usr/local/bin/espanso-x11"
URL="https://github.com/espanso/espanso/releases/download/v${VERSION}/${APPIMAGE}"
TARGET_BIN="${INSTALL_DIR}/${APPIMAGE}"

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

cd "$TMP_DIR"

curl -fL -o "$APPIMAGE" "$URL"
printf '%s  %s\n' "$CHECKSUM" "$APPIMAGE" | sha256sum --check

sudo rm -f "$TARGET_BIN"
sudo mv "$APPIMAGE" "$TARGET_BIN"
sudo chmod +x "$TARGET_BIN"

sudo ln -sfn "$TARGET_BIN" "$BIN_LINK"

echo "Espanso installed: $BIN_LINK -> $TARGET_BIN"
