#!/usr/bin/env bash
set -euo pipefail

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

go_version="$(wget -qO- "https://go.dev/VERSION?m=text" | sed -n '1p')"
archive="${go_version}.linux-amd64.tar.gz"
url="https://go.dev/dl/${archive}"

wget -q -O "${tmp_dir}/${archive}" "$url"

sudo rm -rf /usr/local/go
sudo tar -C /usr/local -xzf "${tmp_dir}/${archive}"

go version
