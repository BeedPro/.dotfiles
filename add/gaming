#!/usr/bin/env bash
set -euo pipefail

sudo xbps-install -Syu

sudo xbps-install -Sy \
    libdrm-32bit \
    lutris \
    steam

if ! command -v flatpak >/dev/null 2>&1; then
    echo "flatpak is not installed. Run add/flathub first."
    exit 1
fi

flatpak install -y flathub org.prismlauncher.PrismLauncher
