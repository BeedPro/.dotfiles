#!/bin/sh
set -eu

# tags: #app

add_root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

command -v flatpak >/dev/null 2>&1 || { echo "flatpak is not installed. Run add/flathub first."; exit 1; }

prompt_install() {
    message="$1"
    shift

    printf '%s [y/N]: ' "$message"
    read -r choice

    case "$choice" in
        y|Y|yes|YES)
            "$@"
            ;;
    esac
}

install_game_streaming() {
    printf 'Install Sunshine server, Moonlight client, or both? [sunshine/moonlight/both] (sunshine): '
    read -r choice

    case "${choice:-sunshine}" in
        sunshine|server)
            flatpak install flathub dev.lizardbyte.app.Sunshine
            ;;
        moonlight|moonshine|client)
            flatpak install flathub com.moonlight_stream.Moonlight
            ;;
        both)
            flatpak install flathub dev.lizardbyte.app.Sunshine com.moonlight_stream.Moonlight
            ;;
        *)
            echo "Invalid choice: $choice"
            exit 1
            ;;
    esac
}

sudo xbps-install -Sy \
    libdrm-32bit \
    steam

flatpak install -y flathub org.prismlauncher.PrismLauncher
"$add_root/heroic"

prompt_install 'Install game streaming apps?' install_game_streaming
prompt_install 'Install Eden NS Emulator?' sudo xbps-install -Sy eden
