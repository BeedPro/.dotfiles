#!/usr/bin/env bash
set -euo pipefail

add_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

command -v cargo >/dev/null 2>&1 || { echo "cargo is not installed. Run add/dev/rust first."; exit 1; }

sudo xbps-install -Sy \
    base-devel \
    curl \
    emacs-gtk3 \
    fd \
    git \
    pandoc \
    ripgrep \
    texlab \
    tinymist \
    tree-sitter-cli \
    unzip \
    xz

"$add_root/dev/tex"
"$add_root/dev/typst"
