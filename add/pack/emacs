#!/usr/bin/env bash
set -euo pipefail

add_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

if ! command -v cargo >/dev/null 2>&1; then echo "cargo is not installed. Run add/lang/rust first."; exit 1; fi

sudo xbps-install -Sy \
    base-devel \
    curl \
    emacs-gtk3 \
    fd \
    git \
    pandoc \
    ripgrep \
    texlab \
    tinymist \
    tree-sitter-cli \
    unzip \
    xz

"$add_root/lang/tex"
"$add_root/lang/typst"
