#!/usr/bin/env bash
set -euo pipefail

default_url="https://download.eclipse.org/jdtls/snapshots/jdt-language-server-latest.tar.gz"
url="${1:-${JDTLS_URL:-$default_url}}"
version="${JDTLS_VERSION:-1.58.0}"
mason_root="${MASON:-${XDG_DATA_HOME:-$HOME/.local/share}/nvim/mason}"
package_dir="$mason_root/packages/jdtls"
bin_dir="$mason_root/bin"
share_dir="$mason_root/share"
staging_dir="$mason_root/staging"

mkdir -p "$bin_dir" "$share_dir" "$staging_dir" "$mason_root/packages"

download_jdtls() {
    local tmp
    tmp="$(mktemp -d "$staging_dir/jdtls.manual.XXXXXX")"
    trap 'rm -rf "$tmp"' EXIT

    curl -fL --retry 3 -o "$tmp/jdtls.tar.gz" "$url"
    tar -xzf "$tmp/jdtls.tar.gz" -C "$tmp"
    curl -fL --retry 3 -o "$tmp/lombok.jar" 'https://projectlombok.org/downloads/lombok.jar'

    if [[ -e "$package_dir" ]]; then
        if [[ "${FORCE:-0}" != 1 ]]; then
            printf '%s already exists. Set FORCE=1 to replace it.\n' "$package_dir" >&2
            exit 1
        fi
        rm -rf "$package_dir"
    fi

    mv "$tmp" "$package_dir"
    trap - EXIT
}

if [[ ! -d "$package_dir" ]]; then
    download_jdtls
fi

launcher=""
for candidate in "$package_dir"/plugins/org.eclipse.equinox.launcher_*.jar; do
    if [[ -f "$candidate" ]]; then
        launcher="$candidate"
        break
    fi
done

if [[ -z "$launcher" ]]; then
    printf 'jdtls launcher jar not found in %s/plugins.\n' "$package_dir" >&2
    exit 1
fi

if [[ ! -d "$package_dir/config_linux" ]]; then
    printf 'jdtls Linux config directory not found: %s/config_linux\n' "$package_dir" >&2
    exit 1
fi

if [[ ! -f "$package_dir/bin/jdtls" ]]; then
    printf 'jdtls executable not found: %s/bin/jdtls\n' "$package_dir" >&2
    exit 1
fi

if [[ ! -f "$package_dir/lombok.jar" ]]; then
    curl -fL --retry 3 -o "$package_dir/lombok.jar" 'https://projectlombok.org/downloads/lombok.jar'
fi

chmod +x "$package_dir/bin/jdtls"

rm -f "$bin_dir/jdtls"
ln -s "$package_dir/bin/jdtls" "$bin_dir/jdtls"

rm -rf "$share_dir/jdtls"
mkdir -p "$share_dir/jdtls/plugins"
ln -s "$package_dir/lombok.jar" "$share_dir/jdtls/lombok.jar"
ln -s "$package_dir/config_linux" "$share_dir/jdtls/config"

while IFS= read -r -d '' file; do
    rel="${file#"$package_dir/plugins/"}"
    mkdir -p "$share_dir/jdtls/plugins/$(dirname "$rel")"
    ln -s "$file" "$share_dir/jdtls/plugins/$rel"
done < <(find "$package_dir/plugins" -type f -print0)

ln -sfn "$launcher" "$share_dir/jdtls/plugins/org.eclipse.equinox.launcher.jar"

python3 - "$mason_root" "$package_dir" "$version" "$url" <<'PY'
import json
import os
import sys
import time

mason_root, package_dir, version, url = sys.argv[1:]
links = {
    "bin": {"jdtls": "bin/jdtls"},
    "share": {
        "jdtls/lombok.jar": "lombok.jar",
        "jdtls/config": "config_linux",
    },
    "opt": {},
}

launcher_target = None
plugins_dir = os.path.join(package_dir, "plugins")
for root, _, files in os.walk(plugins_dir):
    for name in files:
        abs_path = os.path.join(root, name)
        rel = os.path.relpath(abs_path, package_dir)
        plugin_rel = os.path.relpath(abs_path, plugins_dir)
        links["share"][f"jdtls/plugins/{plugin_rel}"] = rel
        if name.startswith("org.eclipse.equinox.launcher_") and name.endswith(".jar"):
            launcher_target = rel

if launcher_target:
    links["share"]["jdtls/plugins/org.eclipse.equinox.launcher.jar"] = launcher_target

now = int(time.time() * 1000)
receipt = {
    "links": links,
    "schema_version": "2.0",
    "source": {
        "id": f"pkg:generic/eclipse/eclipse.jdt.ls@v{version}",
        "raw": {
            "id": f"pkg:generic/eclipse/eclipse.jdt.ls@v{version}",
            "download": [
                {
                    "target": "linux",
                    "files": {
                        "jdtls.tar.gz": url,
                        "lombok.jar": "https://projectlombok.org/downloads/lombok.jar",
                    },
                    "config": "config_linux/",
                }
            ],
        },
        "type": "registry+v1",
    },
    "name": "jdtls",
    "metrics": {"completion_time": now, "start_time": now},
    "install_options": {"force": False, "debug": False, "strict": False},
    "registry": {"proto": "file", "name": "manual", "namespace": "local"},
}

receipt_path = os.path.join(package_dir, "mason-receipt.json")
with open(receipt_path, "w", encoding="utf-8") as file:
    json.dump(receipt, file, separators=(",", ":"))
PY

printf 'Installed Mason-style jdtls at %s\n' "$package_dir"
