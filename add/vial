#!/usr/bin/env bash
set -euo pipefail

# tags: #pkg

sudo xbps-install -Sy curl

VERSION="0.7.5"
APPIMAGE="Vial-v${VERSION}-x86_64.AppImage"
CHECKSUM="b0df22fcc38f85a2d9e2224d2b3fcc76944819365557f1b9a83ee8f880fc7403"
INSTALL_DIR="/opt"
BIN_LINK="/usr/local/bin/vial"
URL="https://github.com/vial-kb/vial-gui/releases/download/v${VERSION}/${APPIMAGE}"
TARGET_BIN="${INSTALL_DIR}/${APPIMAGE}"

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

cd "$TMP_DIR"

curl -fL -o "$APPIMAGE" "$URL"
printf '%s  %s\n' "$CHECKSUM" "$APPIMAGE" | sha256sum --check

sudo rm -f "$TARGET_BIN"
sudo mv "$APPIMAGE" "$TARGET_BIN"
sudo chmod +x "$TARGET_BIN"

sudo ln -sfn "$TARGET_BIN" "$BIN_LINK"

echo "Vial installed: $BIN_LINK -> $TARGET_BIN"
