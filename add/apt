#!/usr/bin/env bash
set -euo pipefail

sudo apt update
sudo apt install -y extrepo
sudo extrepo update
sudo extrepo enable debian_backports

# sudo apt install emacs

CORE_UTILS=(
  bash-completion
  libglib2.0-bin
  tmux
  vim
  git
  curl
  stow
  eza
  bat
  fd-find
  ripgrep
  du-dust
  git-lfs
  python3-venv
  pipx
  rofi
  qalc
  qalculate-gtk
  alacritty
  gucharmap
)

SYSTEM=(
  mediainfo
  acpi
  gpick
  brightnessctl
  pulseaudio-utils
  libnotify-bin
  network-manager
  network-manager-applet
  lxpolkit
  aspell
  aspell-en
  fonts-noto
  fonts-noto-color-emoji
)

X11_TOOLS=(
  picom
  feh
  xss-lock
  dunst
  maim
  x11-xkb-utils
  xclip
  xdotool
)

MEDIA=(
  mpd
  mpc
  mpv
  nsxiv
  zathura
  xournalpp
  libavcodec-extra
  farbfeld
)

THEME=(
  adwaita-qt
  yaru-theme-gtk
  papirus-icon-theme
)

echo "Installing all packages..."
sudo apt install -y "${CORE_UTILS[@]}" "${SYSTEM[@]}" "${X11_TOOLS[@]}" "${MEDIA[@]}" "${THEME[@]}"

if [ -f /usr/bin/batcat ]; then
  sudo ln -sf /usr/bin/batcat /usr/local/bin/bat
fi

if [ -f /usr/bin/fdfind ]; then
  sudo ln -sf /usr/bin/fdfind /usr/local/bin/fd
fi

if [ -f /usr/bin/mpd ]; then
  mkdir -p "$HOME/.local/share/mpd/playlists"
  mkdir -p "$HOME/.cache/mpd"
  mkdir -p "$HOME/.config/mpd"
fi

echo "Installation complete!"
