#!/usr/bin/env bash

set -euo pipefail

if ! command -v go >/dev/null 2>&1; then
  echo 'go is required. Install it first with .voidlinux/add/dev' >&2
  exit 1
fi

go install github.com/natsukagami/mpd-mpris/cmd/mpd-mpris@latest
mkdir -p "$HOME/.config/systemd/user"
ln -sfn "$HOME/.dotfiles/.config/systemd/user/mpd-mpris.service" "$HOME/.config/systemd/user/mpd-mpris.service"
systemctl --user --now enable mpd-mpris
systemctl --user status mpd-mpris
