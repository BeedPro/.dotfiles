#!/usr/bin/env bash

set -euo pipefail

PACKAGES=(
  texlive
  biber
  texlab
  typst
  tinymist
)

sudo xbps-install -Syu
sudo xbps-install -Sy "${PACKAGES[@]}"

printf '%s\n' \
  'Installed LaTeX and Typst tooling from Void repositories.' \
  '' \
  'Skipped tools not found in Void repos:' \
  '- tex-fmt' \
  '- prettypst'
