#!/bin/sh
set -eu

# tags: #pkg

sudo xbps-install -Sy curl

VERSION="2.22.1"
APPIMAGE="Heroic-${VERSION}-linux-x86_64.AppImage"
CHECKSUM="e91e3171c8cb8a57acfcfc7f665e8c74c5a80cf088d5ea61a2af5e6bcc537762"
INSTALL_DIR="/opt"
BIN_LINK="/usr/local/bin/heroic"
URL="https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher/releases/download/v${VERSION}/${APPIMAGE}"
TARGET_BIN="${INSTALL_DIR}/${APPIMAGE}"

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

cd "$TMP_DIR"

curl -fL -o "$APPIMAGE" "$URL"
printf '%s  %s\n' "$CHECKSUM" "$APPIMAGE" | sha256sum --check

sudo rm -f "$TARGET_BIN"
sudo mv "$APPIMAGE" "$TARGET_BIN"
sudo chmod +x "$TARGET_BIN"

sudo ln -sfn "$TARGET_BIN" "$BIN_LINK"

echo "Heroic installed: $BIN_LINK -> $TARGET_BIN"
