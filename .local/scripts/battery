#!/usr/bin/env python3

import os
import re
import shutil
import subprocess
import sys
from pathlib import Path


def command_output(*args: str) -> str:
    return subprocess.run(
        args,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    ).stdout


def main() -> int:
    bat_number = os.environ.get("BAT_NUMBER", "0")
    label = os.environ.get("LABEL", "")

    # Select the configured battery from acpi output; systems may expose
    # BAT0/BAT1.
    acpi_lines = command_output("acpi", "-b").splitlines()
    acpi = next((line for line in acpi_lines if f"Battery {bat_number}" in
                 line), None)

    if acpi is None:
        return 0

    match = re.search(r": ([\w\s]+), (\d+)%", acpi)
    if not match:
        print(acpi, file=sys.stderr)
        return 1

    status = match.group(1)
    percent = int(match.group(2))
    full_text = f":: {label}{percent}%"

    if status == "Discharging":
        full_text += "-"
    elif status == "Charging":
        full_text += "+"
    elif status == "Unknown":
        # Some devices report "Unknown" while AC state still tells us
        # plugged/unplugged.
        ac_adapt = command_output("acpi", "-a")
        adapter_match = re.search(r": ([\w-]+)", ac_adapt)

        if adapter_match:
            adapter_status = adapter_match.group(1)
            if adapter_status == "on-line":
                full_text += " [+]"
            elif adapter_status == "off-line":
                full_text += " [-]"

    short_text = full_text

    time_match = re.search(r"(\d\d:\d\d):", acpi)
    if time_match:
        full_text += f" ({time_match.group(1)})"

    print(short_text)

    if status == "Discharging" and percent < 15:
        # Notify once per 5% bucket to avoid repeated alerts from i3blocks
        # refreshes.
        notify_low_battery(bat_number, percent)

    if status == "Discharging" and percent < 5:
        return 33

    return 0


def notify_low_battery(bat_number: str, percent: int) -> None:
    bucket = percent // 5
    state_file = Path(f"/tmp/.blocks_battery_notify_{bat_number}")
    last_bucket = -1

    try:
        last_bucket = int(state_file.read_text().strip())
    except (FileNotFoundError, ValueError, OSError):
        pass

    if bucket >= 3 or bucket == last_bucket:
        return

    if shutil.which("notify-send"):
        subprocess.run(
            [
                "notify-send",
                "-u",
                "critical",
                "Battery Warning",
                f"Battery low: {percent}% remaining",
            ],
            check=False,
        )

    try:
        state_file.write_text(str(bucket))
    except OSError:
        pass


if __name__ == "__main__":
    sys.exit(main())
