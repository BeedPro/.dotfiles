#!/usr/bin/env python3
"""Take screenshots on X11 using maim."""

import argparse
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path
from typing import Any, Sequence


Geometry = tuple[int, int, int, int]

SCREENSHOT_DIR = Path.home() / "Pictures" / "Screenshots"
MODES = ("everything", "screen", "window", "selection")
MONITOR_RE = re.compile(r"(\d+)/(\d+)x(\d+)/(\d+)\+(\d+)\+(\d+)")
CONNECTED_RE = re.compile(r"^(\d+)x(\d+)\+(\d+)\+(\d+)$")


def run(
    command: Sequence[str],
    **kwargs: Any,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, text=True, check=True, **kwargs)


def mouse_location() -> tuple[int, int]:
    result = run(
        ["xdotool", "getmouselocation", "--shell"],
        capture_output=True,
    )
    values = dict(location_part(line) for line in result.stdout.splitlines())

    return values["X"], values["Y"]


def location_part(line: str) -> tuple[str, int]:
    key, _, value = line.partition("=")
    return key, int(value)


def xrandr_output() -> str:
    result = subprocess.run(
        ["xrandr", "--listactivemonitors"],
        text=True,
        capture_output=True,
    )

    if result.returncode == 0:
        return result.stdout

    return run(["xrandr", "--query"], capture_output=True).stdout


def regex_field_match(
    pattern: re.Pattern[str],
    line: str,
) -> re.Match[str] | None:
    matches = (pattern.search(field) for field in line.split())
    return next(filter(None, matches), None)


def active_monitor_geometry(line: str) -> Geometry | None:
    match = regex_field_match(MONITOR_RE, line)

    if match is None:
        return None

    width, _, height, _, x, y = (int(value) for value in match.groups())
    return width, height, x, y


def connected_monitor_geometry(line: str) -> Geometry | None:
    match = regex_field_match(CONNECTED_RE, line)

    if match is None:
        return None

    width, height, x, y = (int(value) for value in match.groups())
    return width, height, x, y


def monitor_geometry(line: str) -> Geometry | None:
    if re.match(r"^\s*\d+:", line):
        return active_monitor_geometry(line)

    if " connected" in line:
        return connected_monitor_geometry(line)

    return None


def contains_point(geometry: Geometry, x: int, y: int) -> bool:
    width, height, monitor_x, monitor_y = geometry
    inside_x = monitor_x <= x < monitor_x + width
    inside_y = monitor_y <= y < monitor_y + height
    return inside_x and inside_y


def maim_geometry(geometry: Geometry) -> Geometry:
    width, height, x, y = geometry
    return x, y, width, height


def current_monitor_match(
    geometry: Geometry | None,
    mouse_x: int,
    mouse_y: int,
) -> bool:
    return geometry is not None and contains_point(geometry, mouse_x, mouse_y)


def current_monitor_geometry() -> Geometry:
    mouse_x, mouse_y = mouse_location()
    geometries = (
        monitor_geometry(line) for line in xrandr_output().splitlines()
    )
    matches = lambda item: current_monitor_match(item, mouse_x, mouse_y)
    geometry = next(filter(matches, geometries), None)

    if geometry is not None:
        return maim_geometry(geometry)

    print("Could not determine current monitor", file=sys.stderr)
    sys.exit(1)


def take_screenshot(mode: str, final_file: Path) -> None:
    if mode == "everything":
        run(["maim", "-u", str(final_file)])
        return

    if mode == "screen":
        x, y, width, height = current_monitor_geometry()
        geometry = f"{width}x{height}+{x}+{y}"
        run(["maim", "-u", "-g", geometry, str(final_file)])
        return

    if mode == "window":
        run(["maim", "-u", "-i", active_window_id(), str(final_file)])
        return

    command = [
        "maim",
        "-u",
        "-s",
        "-b",
        "1",
        "-c",
        "0.89,0.75,0.98,1.0",
        str(final_file),
    ]
    run(command)


def active_window_id() -> str:
    result = run(["xdotool", "getactivewindow"], capture_output=True)
    return result.stdout.strip()


def send_notification(
    timestamp: str,
    final_file: Path,
    save_screenshot: bool,
) -> None:
    title = "Screenshot taken" if save_screenshot else "Screenshot copied"
    body = f"{timestamp}.png" if save_screenshot else "Not saved to disk"
    run(["notify-send", title, body, "-i", str(final_file)])


def remove_if_temporary(final_file: Path, save_screenshot: bool) -> None:
    if save_screenshot:
        return

    try:
        os.unlink(final_file)
    except FileNotFoundError:
        pass


def nsxiv_command(final_file: Path, full_screen: bool) -> list[str]:
    if full_screen:
        return ["nsxiv", "-f", "-b", "--anti-alias=no", str(final_file)]

    return ["nsxiv", str(final_file)]


def redirect_to_devnull() -> None:
    devnull = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull, sys.stdout.fileno())
    os.dup2(devnull, sys.stderr.fileno())
    os.close(devnull)


def show_then_finish(
    command: Sequence[str],
    timestamp: str,
    final_file: Path,
    save_screenshot: bool,
    notify: bool,
) -> None:
    subprocess.run(command, check=False)

    if notify:
        send_notification(timestamp, final_file, save_screenshot)

    remove_if_temporary(final_file, save_screenshot)


def fork_viewer(
    command: Sequence[str],
    timestamp: str,
    final_file: Path,
    save_screenshot: bool,
    notify: bool,
) -> None:
    if os.fork() != 0:
        return

    os.setsid()
    redirect_to_devnull()
    show_then_finish(command, timestamp, final_file, save_screenshot, notify)
    os._exit(0)


def parse_args() -> argparse.Namespace:
    usage = " ".join((
        "%(prog)s [everything|screen|window|selection]",
        "[--show] [--full-screen] [--no-save] [--no-notify]",
    ))
    parser = argparse.ArgumentParser(
        usage=usage,
    )
    parser.add_argument("mode", choices=MODES)
    parser.add_argument("--show", action="store_true")
    parser.add_argument("--full-screen", action="store_true")
    parser.add_argument("--no-save", action="store_true")
    parser.add_argument("--no-notify", action="store_true")
    return parser.parse_args()


def final_file(timestamp: str, save_screenshot: bool) -> Path:
    if save_screenshot:
        return SCREENSHOT_DIR / f"{timestamp}.png"

    temporary_file = tempfile.NamedTemporaryFile(suffix=".png", delete=False)
    temporary_file.close()
    return Path(temporary_file.name)


def finish_without_viewer(
    timestamp: str,
    path: Path,
    save_screenshot: bool,
    notify: bool,
) -> None:
    if notify:
        send_notification(timestamp, path, save_screenshot)

    remove_if_temporary(path, save_screenshot)


def main() -> int:
    args = parse_args()
    timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    save_screenshot = not args.no_save
    path = final_file(timestamp, save_screenshot)

    SCREENSHOT_DIR.mkdir(parents=True, exist_ok=True)

    try:
        take_screenshot(args.mode, path)
        run(xclip_command(path))
    except Exception:
        remove_if_temporary(path, save_screenshot)
        raise

    if args.show or args.full_screen:
        notify = not args.no_notify
        viewer_command = nsxiv_command(path, args.full_screen)
        fork_viewer(viewer_command, timestamp, path, save_screenshot, notify)
        return 0

    finish_without_viewer(timestamp, path, save_screenshot, not args.no_notify)
    return 0


def xclip_command(path: Path) -> list[str]:
    return [
        "xclip",
        "-selection",
        "clipboard",
        "-t",
        "image/png",
        "-i",
        str(path),
    ]


if __name__ == "__main__":
    raise SystemExit(main())
