#!/bin/sh

set -e

BATCH="$1"

if [ -z "$BATCH" ]; then
    printf 'Usage: %s {chat|email}\n' "$0"
    exit 1
fi

case "$BATCH" in
    chat)
        set -- \
            "https://app.element.io/" \
            "https://discord.com/app" \
            "https://web.whatsapp.com/"
        ;;
    email)
        set -- \
            "https://mail.google.com" \
            "https://outlook.live.com" \
            "https://outlook.office.com"
        ;;
    *)
        printf 'Unknown batch: %s\n' "$BATCH"
        printf '%s\n' 'Available batches: chat, email'
        exit 1
        ;;
esac

# Open each URL in its own new window
for url do
    firefox --new-window "$url" &
done
