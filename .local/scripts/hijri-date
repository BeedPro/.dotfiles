#!/usr/bin/env python3

import json
import os
import subprocess
import sys
from datetime import datetime, time, timedelta
from pathlib import Path
from typing import Any
from urllib.parse import urlencode
from urllib.request import urlopen

PRAYER_CACHE = "/tmp/prayer-times.json"
PRAYER_SCRIPT = os.path.expanduser("~/.local/scripts/prayer-times")
HIJRI_CACHE = "/tmp/hijri-date.json"

TIMINGS_API_URL = "https://api.aladhan.com/v1/timings"
ARABIC_DIGITS = str.maketrans("0123456789", "٠١٢٣٤٥٦٧٨٩")
JsonObject = dict[str, Any]


def gregorian_str(dt: datetime) -> str:
    return dt.strftime("%d-%m-%Y")


def generate_cache() -> None:
    subprocess.run(
        [PRAYER_SCRIPT],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=True,
    )


def read_prayer_cache() -> JsonObject:
    if not os.path.exists(PRAYER_CACHE):
        generate_cache()

    return json.loads(Path(PRAYER_CACHE).read_text())


def get_maghrib_time() -> time:
    data = read_prayer_cache()
    maghrib = data["data"]["timings"]["Maghrib"].split(" ")[0]
    return datetime.strptime(maghrib, "%H:%M").time()


def after_maghrib(maghrib_time: time) -> bool:
    return datetime.now().time() >= maghrib_time


def effective_gregorian_date() -> datetime:
    """
    Before Maghrib  -> today
    After Maghrib   -> tomorrow
    """
    today = datetime.now()
    maghrib = get_maghrib_time()

    if after_maghrib(maghrib):
        return today + timedelta(days=1)

    return today


def load_cache() -> JsonObject | None:
    if not os.path.exists(HIJRI_CACHE):
        return None

    try:
        return json.loads(Path(HIJRI_CACHE).read_text())
    except Exception:
        return None


def save_cache(key: str, hijri_data: JsonObject) -> None:
    payload = {
        "key": key,
        "source": "timings",
        "hijri": hijri_data,
    }

    try:
        Path(HIJRI_CACHE).write_text(json.dumps(payload))
    except Exception:
        pass


def fetch_timings(gregorian_date: datetime) -> JsonObject:
    params = {
        "latitude": 51.5074,
        "longitude": -0.1278,
        "method": 2,
        "timezonestring": "Europe/London",
    }
    url = f"{TIMINGS_API_URL}/{gregorian_str(gregorian_date)}?{urlencode(params)}"

    response = urlopen(url, timeout=10)
    data = json.loads(response.read().decode())
    response.close()

    if data.get("code") != 200:
        raise RuntimeError("API error")

    return data


def hijri_from_prayer_cache(gregorian_date: datetime) -> JsonObject | None:
    try:
        data = read_prayer_cache()
        date = data["data"]["date"]["gregorian"]["date"]
        hijri = data["data"]["date"]["hijri"]
    except Exception:
        return None

    if date != gregorian_str(gregorian_date):
        return None

    return hijri


def hijri_from_cache(cache: JsonObject | None, cache_key: str) -> JsonObject | None:
    if not cache:
        return None

    if cache.get("key") != cache_key or cache.get("source") != "timings":
        return None

    return cache["hijri"]


def fetch_hijri(gregorian_date: datetime) -> JsonObject:
    hijri = hijri_from_prayer_cache(gregorian_date)

    if hijri:
        return hijri

    return fetch_timings(gregorian_date)["data"]["date"]["hijri"]


def fetch_or_cached_hijri(
    effective_date: datetime,
    cache_key: str,
    cache: JsonObject | None,
) -> JsonObject | None:
    hijri = hijri_from_cache(cache, cache_key)

    if hijri:
        return hijri

    try:
        hijri = fetch_hijri(effective_date)
        save_cache(cache_key, hijri)
        return hijri
    except Exception:
        return cache["hijri"] if cache else None


def format_hijri_date(hijri: JsonObject, arabic: bool = False) -> str:
    if arabic:
        formatted = f"{int(hijri['day']):02d}.{int(hijri['month']['number']):02d}.{hijri['year']}"
        return formatted.translate(ARABIC_DIGITS)

    return f"{hijri['year']}.{int(hijri['month']['number']):02d}.{int(hijri['day']):02d}"


def main() -> None:
    arabic_output = any(arg in {"--arabic", "-a"} for arg in sys.argv[1:])

    try:
        effective_date = effective_gregorian_date()
        cache_key = gregorian_str(effective_date)
    except Exception:
        print(":: --")
        return

    cache = load_cache()
    hijri = fetch_or_cached_hijri(effective_date, cache_key, cache)

    if not hijri:
        print(":: --")
        return

    print(f":: {format_hijri_date(hijri, arabic=arabic_output)}")


if __name__ == "__main__":
    main()
