#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import subprocess
import time
from dataclasses import asdict, dataclass
from pathlib import Path


@dataclass
class Preferences:
    gtk_theme: str
    icon_theme: str
    font_name: str
    cursor_theme: str
    cursor_size: int
    toolbar_style: str
    toolbar_icons_size: str
    font_hinting: str
    font_antialiasing: str
    font_rgba_order: str
    text_scaling_factor: float
    color_scheme: str
    event_sounds: bool
    input_feedback_sounds: bool


START = time.monotonic()
HOME = Path.home()
GTK3_SETTINGS = HOME / ".config/gtk-3.0/settings.ini"
COLOR_SCHEMES = {"default", "prefer-dark", "prefer-light"}


def log(message: str) -> None:
    elapsed = int(time.monotonic() - START)
    print(f"INFO[{elapsed:04d}] {message}")


def run_gsettings(args: list[str]) -> str:
    result = subprocess.run(["gsettings", *args], capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "gsettings failed")
    return result.stdout.strip()


def parse_gsettings_value(raw: str) -> str:
    return raw[1:-1] if raw.startswith("'") and raw.endswith("'") else raw


def read_interface_prefs() -> dict[str, str]:
    keys = [
        "gtk-theme",
        "icon-theme",
        "font-name",
        "cursor-theme",
        "cursor-size",
        "toolbar-style",
        "toolbar-icons-size",
        "font-hinting",
        "font-antialiasing",
        "font-rgba-order",
        "text-scaling-factor",
        "color-scheme",
    ]
    return {key: parse_gsettings_value(run_gsettings(["get", "org.gnome.desktop.interface", key])) for key in keys}


def read_sound_prefs() -> dict[str, str]:
    keys = ["event-sounds", "input-feedback-sounds"]
    return {key: parse_gsettings_value(run_gsettings(["get", "org.gnome.desktop.sound", key])) for key in keys}


def load_preferences() -> Preferences:
    interface = read_interface_prefs()
    sound = read_sound_prefs()
    return Preferences(
        gtk_theme=interface["gtk-theme"],
        icon_theme=interface["icon-theme"],
        font_name=interface["font-name"],
        cursor_theme=interface["cursor-theme"],
        cursor_size=int(float(interface["cursor-size"])),
        toolbar_style=interface["toolbar-style"],
        toolbar_icons_size=interface["toolbar-icons-size"],
        font_hinting=interface["font-hinting"],
        font_antialiasing=interface["font-antialiasing"],
        font_rgba_order=interface["font-rgba-order"],
        text_scaling_factor=float(interface["text-scaling-factor"]),
        color_scheme=interface["color-scheme"],
        event_sounds=sound["event-sounds"] == "true",
        input_feedback_sounds=sound["input-feedback-sounds"] == "true",
    )


def with_overrides(
    prefs: Preferences,
    gtk_theme: str | None,
    icon_theme: str | None,
    color_scheme: str,
) -> Preferences:
    return Preferences(
        gtk_theme=gtk_theme or prefs.gtk_theme,
        icon_theme=icon_theme or prefs.icon_theme,
        font_name=prefs.font_name,
        cursor_theme=prefs.cursor_theme,
        cursor_size=prefs.cursor_size,
        toolbar_style=prefs.toolbar_style,
        toolbar_icons_size=prefs.toolbar_icons_size,
        font_hinting=prefs.font_hinting,
        font_antialiasing=prefs.font_antialiasing,
        font_rgba_order=prefs.font_rgba_order,
        text_scaling_factor=prefs.text_scaling_factor,
        color_scheme=color_scheme,
        event_sounds=prefs.event_sounds,
        input_feedback_sounds=prefs.input_feedback_sounds,
    )


def directories_for(kind: str) -> list[Path]:
    if kind == "gtk-theme":
        roots = [Path("/usr/share/themes"), Path("/usr/local/share/themes"), HOME / ".themes"]
        return [p for p in roots if p.exists()]
    roots = [Path("/usr/share/icons"), Path("/usr/local/share/icons"), HOME / ".icons"]
    return [p for p in roots if p.exists()]


def discover_names(kind: str) -> list[str]:
    names: set[str] = set()
    for root in directories_for(kind):
        for child in root.iterdir():
            if child.is_dir() and (child / "index.theme").exists():
                names.add(child.name)
    return sorted(names)


def print_name_list(kind: str) -> None:
    names = discover_names(kind)
    header = "GTK themes:" if kind == "gtk-theme" else "Icon themes:"
    print(header)
    for name in names:
        print(name)


def validate_name(kind: str, name: str | None) -> None:
    if not name:
        return
    names = discover_names(kind)
    if name in names:
        return
    hint = f"gtk-teme list {kind}"
    raise ValueError(f"Unknown {kind}: '{name}'. See: {hint}")


def gvariant_string(value: str) -> str:
    escaped = value.replace("'", "\\'")
    return f"'{escaped}'"


def gvariant_bool(value: bool) -> str:
    return "true" if value else "false"


def gvariant_num(value: int | float) -> str:
    return str(value)


def apply_gsettings(prefs: Preferences) -> None:
    log(">>> Applying gsettings")
    interface = [
        ("gtk-theme", gvariant_string(prefs.gtk_theme)),
        ("icon-theme", gvariant_string(prefs.icon_theme)),
        ("cursor-theme", gvariant_string(prefs.cursor_theme)),
        ("cursor-size", gvariant_num(prefs.cursor_size)),
        ("font-name", gvariant_string(prefs.font_name)),
        ("font-hinting", gvariant_string(prefs.font_hinting)),
        ("font-antialiasing", gvariant_string(prefs.font_antialiasing)),
        ("font-rgba-order", gvariant_string(prefs.font_rgba_order)),
        ("text-scaling-factor", gvariant_num(prefs.text_scaling_factor)),
        ("toolbar-style", gvariant_string(prefs.toolbar_style)),
        ("toolbar-icons-size", gvariant_string(prefs.toolbar_icons_size)),
        ("color-scheme", gvariant_string(prefs.color_scheme)),
    ]
    log(">> org.gnome.desktop.interface")
    for key, value in interface:
        run_gsettings(["set", "org.gnome.desktop.interface", key, value])
        log(f"{key}: {parse_gsettings_value(run_gsettings(['get', 'org.gnome.desktop.interface', key]))} OK")
    sound = [
        ("event-sounds", gvariant_bool(prefs.event_sounds)),
        ("input-feedback-sounds", gvariant_bool(prefs.input_feedback_sounds)),
    ]
    log(">> org.gnome.desktop.sound")
    for key, value in sound:
        run_gsettings(["set", "org.gnome.desktop.sound", key, value])
        log(f"{key}: {parse_gsettings_value(run_gsettings(['get', 'org.gnome.desktop.sound', key]))} OK")


def bool_to_int(value: bool) -> int:
    return 1 if value else 0


def write_file(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    log(f">>> Exporting {path}")


def gtk_toolbar_style(style: str) -> str:
    mapping = {"both-horiz": "GTK_TOOLBAR_BOTH_HORIZ", "both": "GTK_TOOLBAR_BOTH", "icons": "GTK_TOOLBAR_ICONS", "text": "GTK_TOOLBAR_TEXT"}
    return mapping.get(style, "GTK_TOOLBAR_ICONS")


def gtk_toolbar_icon_size(size: str) -> str:
    mapping = {"small": "GTK_ICON_SIZE_SMALL_TOOLBAR", "large": "GTK_ICON_SIZE_LARGE_TOOLBAR"}
    return mapping.get(size, "GTK_ICON_SIZE_LARGE_TOOLBAR")


def xft_antialias(value: str) -> int:
    return 0 if value == "none" else 1


def xft_hinting(value: str) -> int:
    return 0 if value in {"none", ""} else 1


def xft_hintstyle(value: str) -> str:
    return "hintnone" if value == "none" else f"hint{value}"


def export_gtk3_settings(prefs: Preferences) -> None:
    content = "\n".join([
        "[Settings]",
        f"gtk-theme-name={prefs.gtk_theme}",
        f"gtk-icon-theme-name={prefs.icon_theme}",
        f"gtk-font-name={prefs.font_name}",
        f"gtk-cursor-theme-name={prefs.cursor_theme}",
        f"gtk-cursor-theme-size={prefs.cursor_size}",
        f"gtk-toolbar-style={gtk_toolbar_style(prefs.toolbar_style)}",
        f"gtk-toolbar-icon-size={gtk_toolbar_icon_size(prefs.toolbar_icons_size)}",
        "gtk-button-images=0",
        "gtk-menu-images=0",
        f"gtk-enable-event-sounds={bool_to_int(prefs.event_sounds)}",
        f"gtk-enable-input-feedback-sounds={bool_to_int(prefs.input_feedback_sounds)}",
        f"gtk-xft-antialias={xft_antialias(prefs.font_antialiasing)}",
        f"gtk-xft-hinting={xft_hinting(prefs.font_hinting)}",
        f"gtk-xft-hintstyle={xft_hintstyle(prefs.font_hinting)}",
        f"gtk-xft-rgba={prefs.font_rgba_order}",
        f"gtk-application-prefer-dark-theme={1 if prefs.color_scheme == 'prefer-dark' else 0}",
        "",
    ])
    write_file(GTK3_SETTINGS, content)


def export_gtk2_settings(prefs: Preferences) -> None:
    content = "\n".join([
        "# DO NOT EDIT! This file will be overwritten by gtk-teme.",
        "# Any customization should be done in ~/.gtkrc-2.0.mine instead.",
        "",
        f'include "{HOME}/.gtkrc-2.0.mine"',
        f'gtk-theme-name="{prefs.gtk_theme}"',
        f'gtk-icon-theme-name="{prefs.icon_theme}"',
        f'gtk-font-name="{prefs.font_name}"',
        f'gtk-cursor-theme-name="{prefs.cursor_theme}"',
        f"gtk-cursor-theme-size={prefs.cursor_size}",
        f"gtk-toolbar-style={gtk_toolbar_style(prefs.toolbar_style)}",
        f"gtk-toolbar-icon-size={gtk_toolbar_icon_size(prefs.toolbar_icons_size)}",
        "gtk-button-images=0",
        "gtk-menu-images=0",
        f"gtk-enable-event-sounds={bool_to_int(prefs.event_sounds)}",
        f"gtk-enable-input-feedback-sounds={bool_to_int(prefs.input_feedback_sounds)}",
        f"gtk-xft-antialias={xft_antialias(prefs.font_antialiasing)}",
        f"gtk-xft-hinting={xft_hinting(prefs.font_hinting)}",
        f'gtk-xft-hintstyle="{xft_hintstyle(prefs.font_hinting)}"',
        f'gtk-xft-rgba="{prefs.font_rgba_order}"',
        "",
    ])
    write_file(HOME / ".gtkrc-2.0", content)


def export_cursor_theme(prefs: Preferences) -> None:
    content = "\n".join([
        "# This file is written by gtk-teme. Do not edit.",
        "[Icon Theme]",
        "Name=Default",
        "Comment=Default Cursor Theme",
        f"Inherits={prefs.cursor_theme}",
        "",
    ])
    write_file(HOME / ".icons/default/index.theme", content)


def export_xsettingsd(prefs: Preferences) -> None:
    content = "\n".join([
        f'Net/ThemeName "{prefs.gtk_theme}"',
        f'Net/IconThemeName "{prefs.icon_theme}"',
        f'Gtk/CursorThemeName "{prefs.cursor_theme}"',
        f"Net/EnableEventSounds {bool_to_int(prefs.event_sounds)}",
        f"EnableInputFeedbackSounds {bool_to_int(prefs.input_feedback_sounds)}",
        f"Xft/Antialias {xft_antialias(prefs.font_antialiasing)}",
        f"Xft/Hinting {xft_hinting(prefs.font_hinting)}",
        f'Xft/HintStyle "{xft_hintstyle(prefs.font_hinting)}"',
        f'Xft/RGBA "{prefs.font_rgba_order}"',
        "",
    ])
    write_file(HOME / ".config/xsettingsd/xsettingsd.conf", content)


def export_gtk4_settings(prefs: Preferences) -> None:
    content = "\n".join([
        "[Settings]",
        f"gtk-theme-name={prefs.gtk_theme}",
        f"gtk-icon-theme-name={prefs.icon_theme}",
        f"gtk-font-name={prefs.font_name}",
        f"gtk-application-prefer-dark-theme={1 if prefs.color_scheme == 'prefer-dark' else 0}",
        "",
    ])
    write_file(HOME / ".config/gtk-4.0/settings.ini", content)


def backup_preferences(prefs: Preferences) -> None:
    backup_dir = HOME / ".local/share/nwg-look"
    backup_dir.mkdir(parents=True, exist_ok=True)
    backup_file = backup_dir / "gsettings.json"
    backup_file.write_text(json.dumps(asdict(prefs), indent=2) + "\n")
    log(f">>> Backing up gsettings to {backup_dir}")


def symlink_gtk4_theme_files(prefs: Preferences) -> None:
    target_dir = HOME / ".config/gtk-4.0"
    source_dir = Path("/usr/share/themes") / prefs.gtk_theme / "gtk-4.0"
    target_dir.mkdir(parents=True, exist_ok=True)
    for name in ["gtk.css", "gtk-dark.css"]:
        dst = target_dir / name
        src = source_dir / name
        if dst.is_symlink() or dst.exists():
            dst.unlink()
        if src.exists():
            dst.symlink_to(src)
    log(f">>> Symlinking files in {target_dir}")


def export_files(prefs: Preferences) -> None:
    export_gtk3_settings(prefs)
    export_gtk2_settings(prefs)
    export_cursor_theme(prefs)
    export_xsettingsd(prefs)
    export_gtk4_settings(prefs)
    symlink_gtk4_theme_files(prefs)


def print_preferences(prefs: Preferences) -> None:
    log(f"gtk-theme: {prefs.gtk_theme}")
    log(f"icon-theme: {prefs.icon_theme}")
    log(f"font-name: {prefs.font_name}")
    log(f"cursor-theme: {prefs.cursor_theme}")
    log(f"cursor-size: {prefs.cursor_size}")
    log(f"toolbar-style: {prefs.toolbar_style}")
    log(f"toolbar-icons-size: {prefs.toolbar_icons_size}")
    log(f"font-hinting: {prefs.font_hinting}")
    log(f"font-antialiasing: {prefs.font_antialiasing}")
    log(f"font-rgba-order: {prefs.font_rgba_order}")
    log(f"text-scaling-factor: {prefs.text_scaling_factor:g}")
    log(f"color-scheme: {prefs.color_scheme}")
    log(f"event-sounds: {str(prefs.event_sounds).lower()}")
    log(f"input-feedback-sounds: {str(prefs.input_feedback_sounds).lower()}")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="CLI GTK appearance exporter like nwg-look")
    subparsers = parser.add_subparsers(dest="command")
    apply_parser = subparsers.add_parser("apply", help="Apply and export GTK preferences")
    apply_parser.add_argument("--gtk-theme", help="Override GTK theme")
    apply_parser.add_argument("--icon-theme", help="Override icon theme")
    apply_parser.add_argument("--color-scheme", default="default", choices=sorted(COLOR_SCHEMES), help="Set GNOME color scheme")
    list_parser = subparsers.add_parser("list", help="List available names")
    list_parser.add_argument("target", choices=["gtk-theme", "icon-theme"], help="What to list")
    return parser.parse_args()


def run_list(args: argparse.Namespace) -> None:
    print_name_list(args.target)


def run_apply(args: argparse.Namespace) -> None:
    log(">>> Loading preferences")
    log(f"lang: {os.environ.get('LANG', 'en_US')}")
    log(">>> Reading gsettings")
    base = load_preferences()
    validate_name("gtk-theme", args.gtk_theme)
    validate_name("icon-theme", args.icon_theme)
    prefs = with_overrides(base, args.gtk_theme, args.icon_theme, args.color_scheme)
    print_preferences(prefs)
    if GTK3_SETTINGS.exists():
        log(f">>> Parsing original {GTK3_SETTINGS}")
    apply_gsettings(prefs)
    backup_preferences(prefs)
    export_files(prefs)


def normalize_to_apply(argv: list[str]) -> list[str]:
    if not argv:
        return ["apply"]
    if argv[0] in {"apply", "list", "-h", "--help"}:
        return argv
    return ["apply", *argv]


def main() -> None:
    import sys

    sys.argv = [sys.argv[0], *normalize_to_apply(sys.argv[1:])]
    args = parse_args()
    if args.command == "list":
        run_list(args)
        return
    run_apply(args)


if __name__ == "__main__":
    main()
