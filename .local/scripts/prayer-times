#!/usr/bin/env python3
import json
from collections.abc import Callable
from datetime import datetime, time, timedelta
from json import JSONDecodeError
from pathlib import Path
from typing import Any, TypeVar
from urllib.error import URLError
from urllib.parse import urlencode
from urllib.request import urlopen

CACHE_FILE = Path("/tmp/prayer-times.json")
TIMING_ORDER = ("Fajr", "Sunrise", "Dhuhr", "Asr", "Maghrib", "Isha")
TIMINGS_URL = "https://api.aladhan.com/v1/timings"
TIMINGS_PARAMS = {
    "latitude": 51.5074,
    "longitude": -0.1278,
    "method": 2,
    "timezonestring": "Europe/London",
}

JsonObject = dict[str, Any]
PrayerWindow = tuple[str, str, str, str]
ParsedTimings = list[tuple[str, datetime]]
FuturePrayer = tuple[int, str] | None
T = TypeVar("T")


def run_or_none(callback: Callable[[], T]) -> T | None:
    try:
        return callback()
    except (
        OSError,
        JSONDecodeError,
        KeyError,
        RuntimeError,
        TimeoutError,
        TypeError,
        URLError,
        ValueError,
    ):
        return None


def fetch_prayer_times() -> JsonObject:
    date_str = datetime.now().astimezone().strftime("%d-%m-%Y")
    url = f"{TIMINGS_URL}/{date_str}?{urlencode(TIMINGS_PARAMS)}"
    response = urlopen(url, timeout=10)
    try: return json.loads(response.read().decode())
    finally: response.close()


def read_cache() -> JsonObject | None:
    if CACHE_FILE.exists(): return run_or_none(read_cache_file)
    return None


def read_cache_file() -> JsonObject:
    return json.loads(CACHE_FILE.read_text())


def write_cache(data: JsonObject) -> None:
    run_or_none(lambda: CACHE_FILE.write_text(json.dumps(data)))


def cache_date(data: JsonObject) -> str | None:
    date_data = data.get("data", {}).get("date", {})
    return date_data.get("gregorian", {}).get("date")


def load_prayer_times() -> JsonObject:
    today = datetime.now().astimezone().strftime("%d-%m-%Y")
    cached_data = read_cache()
    if cached_data and cache_date(cached_data) == today: return cached_data
    data = fetch_prayer_times()
    if data.get("code") == 200: write_cache(data); return data
    raise RuntimeError("API error")


def parse_time_today(time_str: str) -> datetime:
    now = datetime.now().astimezone()
    clean_time = time_str.split(" ")[0]
    parsed_time = time.fromisoformat(clean_time)
    return datetime.combine(now.date(), parsed_time, tzinfo=now.tzinfo)


def result_for_future(
    index: int,
    next_name: str,
    timings: dict[str, str],
    parsed: ParsedTimings,
) -> PrayerWindow:
    current_name = parsed[index - 1][0] if index > 0 else "Isha"
    current_time = timings[current_name].split(" ")[0]
    next_time = timings[next_name].split(" ")[0]
    return current_name, current_time, next_name, next_time


def result_after_isha(timings: dict[str, str]) -> PrayerWindow:
    fajr_time = parse_time_today(timings["Fajr"]) + timedelta(days=1)
    current_time = timings["Isha"].split(" ")[0]
    return "Isha", current_time, "Fajr", fajr_time.strftime("%H:%M")


def find_future_prayer(parsed: ParsedTimings) -> FuturePrayer:
    now = datetime.now().astimezone()
    future = [
    (index, name)
    for index, (name, prayer_time) in enumerate(parsed)
    if now < prayer_time
    ]
    return future[0] if future else None


def get_current_and_next(timings: dict[str, str]) -> PrayerWindow:
    parsed = [(name, parse_time_today(timings[name])) for name in TIMING_ORDER]
    future = find_future_prayer(parsed)
    if future: return result_for_future(future[0], future[1], timings, parsed)
    return result_after_isha(timings)


def format_output() -> str:
    data = load_prayer_times()
    timings = data["data"]["timings"]
    current_name, _, next_name, next_time = get_current_and_next(timings)
    hh, mm = next_time.split(":", 1)
    return f"{current_name[:2]}:{next_name[:2]}[{hh}:{mm}]"


def main() -> None:
    print(run_or_none(format_output) or "--")


if __name__ == "__main__":
    main()
