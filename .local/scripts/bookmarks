#!/bin/sh

BOOKMARKS_FILE="$HOME/Compendium/Journal/bookmarks.txt"

die() {
    printf '%s\n' "$1" >&2
    exit 1
}

usage() {
    printf 'Usage: %s [bookmarks_file]\n' "$(basename "$0")"
}

copy_wayland() {
    command -v wl-copy >/dev/null 2>&1 || die 'Error: wayland session detected but wl-copy is not installed'
    printf '%s' "$URL" | wl-copy
}

copy_x11() {
    command -v xclip >/dev/null 2>&1 && printf '%s' "$URL" | xclip -selection clipboard && return
    command -v xsel >/dev/null 2>&1 && printf '%s' "$URL" | xsel --clipboard --input && return
    die 'Error: x11 session detected but neither xclip nor xsel is installed'
}

copy_url() {
    [ "${XDG_SESSION_TYPE:-}" = "wayland" ] && copy_wayland && return
    [ "${XDG_SESSION_TYPE:-}" = "x11" ] && copy_x11 && return
    die "Error: unsupported or unknown session type: ${XDG_SESSION_TYPE:-unset}"
}

[ "$#" -gt 1 ] && die "Error: too many arguments"

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
    -*)
        die "Error: unknown option: $1"
        ;;
    ?*)
        BOOKMARKS_FILE="$1"
        ;;
esac

[ -f "$BOOKMARKS_FILE" ] || die "Error: bookmarks file not found: $BOOKMARKS_FILE"

CHOICE="$(awk -F'|' 'NF>=2 {print $1}' "$BOOKMARKS_FILE" | rofi -dmenu -i -p 'Bookmarks')"

[ -z "$CHOICE" ] && exit 0

URL="$(awk -F'|' -v choice="$CHOICE" '$1 == choice {print $2; exit}' "$BOOKMARKS_FILE")"

[ -z "$URL" ] && exit 1

copy_url
