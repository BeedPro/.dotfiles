#!/usr/bin/env python3

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path

DEFAULT_BOOKMARKS_FILE = Path.home() / "Compendium/Journal/bookmarks.txt"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog=Path(sys.argv[0]).name,
        usage="%(prog)s [bookmarks_file]",
        description="Select a bookmark with rofi and copy its URL to the clipboard.",
    )
    parser.add_argument(
        "bookmarks_file", nargs="?", default=str(DEFAULT_BOOKMARKS_FILE)
    )
    return parser.parse_args()


def load_bookmarks(bookmarks_file: Path) -> list[tuple[str, str]]:
    if not bookmarks_file.is_file():
        print(f"Error: bookmarks file not found: {bookmarks_file}", file=sys.stderr)
        sys.exit(1)

    bookmarks: list[tuple[str, str]] = []
    with bookmarks_file.open(encoding="utf-8") as file:
        for line in file:
            name, separator, url = line.rstrip("\n").partition("|")
            if separator:
                bookmarks.append((name, url))

    return bookmarks


def choose_bookmark(bookmarks: list[tuple[str, str]]) -> str:
    names = "\n".join(name for name, _ in bookmarks)
    if names:
        names += "\n"

    result = subprocess.run(
        ["rofi", "-dmenu", "-i", "-p", "Bookmarks"],
        input=names,
        text=True,
        capture_output=True,
        check=False,
    )

    return result.stdout.rstrip("\n")


def copy_to_clipboard(url: str) -> None:
    session_type = os.environ.get("XDG_SESSION_TYPE", "")

    if session_type == "wayland":
        if shutil.which("wl-copy") is None:
            print(
                "Error: wayland session detected but wl-copy is not installed",
                file=sys.stderr,
            )
            sys.exit(1)
        subprocess.run(["wl-copy"], input=url, text=True, check=True)
        return

    if session_type == "x11":
        if shutil.which("xclip") is not None:
            subprocess.run(
                ["xclip", "-selection", "clipboard"], input=url, text=True, check=True
            )
            return
        if shutil.which("xsel") is not None:
            subprocess.run(
                ["xsel", "--clipboard", "--input"], input=url, text=True, check=True
            )
            return
        print(
            "Error: x11 session detected but neither xclip nor xsel is installed",
            file=sys.stderr,
        )
        sys.exit(1)

    print(
        f"Error: unsupported or unknown session type: {session_type or 'unset'}",
        file=sys.stderr,
    )
    sys.exit(1)


def main() -> int:
    args = parse_args()
    bookmarks = load_bookmarks(Path(args.bookmarks_file).expanduser())
    choice = choose_bookmark(bookmarks)

    if not choice:
        return 0

    for name, url in bookmarks:
        if name == choice:
            copy_to_clipboard(url)
            return 0

    return 1


if __name__ == "__main__":
    sys.exit(main())
