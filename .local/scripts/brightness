#!/usr/bin/env python3

from pathlib import Path
import re
import subprocess
import sys


def run(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, capture_output=True, text=True, check=False)


def set_brightness(command: str | None) -> None:
    commands = {"up": ("brightnessctl", "set", "+5%"), "down": ("brightnessctl", "set", "5%-")}
    args = commands.get(command)
    args and run(*args)


def backlight_exists() -> bool:
    backlight = Path("/sys/class/backlight")
    return backlight.is_dir() and any(backlight.iterdir())


def brightness_percent() -> int | None:
    match = re.search(r"\((\d+)%\)", run("brightnessctl").stdout)
    return int(match.group(1)) if match else None


def brightness_body(percent: int) -> str:
    bar_val = max(0, min(percent, 100))
    bar_width = 35
    filled = bar_val * bar_width // 100
    empty = bar_width - filled
    return f"[{'|' * filled}{'-' * empty}]"


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else None
    set_brightness(command)

    percent = brightness_percent() if backlight_exists() else None
    title = f"Brightness {percent}%" if percent is not None else "Brightness"
    body = brightness_body(percent) if percent is not None else "lux --%"

    run("notify-send", "-r", "9998", "-t", "1000", title, f"\n{body}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
