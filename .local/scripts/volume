#!/bin/sh
SINK="@DEFAULT_SINK@"

case "$1" in
    up)
        pactl set-sink-mute "$SINK" 0
        pactl set-sink-volume "$SINK" +5%
        ;;
    down)
        pactl set-sink-mute "$SINK" 0
        pactl set-sink-volume "$SINK" -5%
        ;;
    mute)
        pactl set-sink-mute "$SINK" toggle
        ;;
esac

info=$(pactl get-sink-volume "$SINK" 2>/dev/null)
mute=$(pactl get-sink-mute "$SINK" 2>/dev/null)

TITLE="Volume"
BODY="Unavailable"
HINT_VALUE=0

if [ -n "$info" ] && [ -n "$mute" ]; then
    vol=$(printf '%s\n' "$info" | grep -oP '\d+%' | head -1 | tr -d '%')

    bar_vol=$vol
    [ "$bar_vol" -gt 100 ] && bar_vol=100
    [ "$bar_vol" -lt 0 ] && bar_vol=0
    HINT_VALUE=$bar_vol

    if printf '%s\n' "$mute" | grep -q yes; then
        TITLE="Volume: ${vol}% [muted]"
        BODY=""
    else
        TITLE="Volume: ${vol}%"
        BODY=""
    fi
fi

notify-send \
    -r 9999 \
    -t 1000 \
    -h "string:synchronous:volume" \
    -h "int:value:$HINT_VALUE" \
    "$TITLE" "$BODY"
