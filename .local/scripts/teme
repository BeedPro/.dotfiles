GTK_START = time.monotonic()


@dataclass
class GtkPreferences:
    gtk_theme: str
    icon_theme: str
    font_name: str
    cursor_theme: str
    cursor_size: int
    toolbar_style: str
    toolbar_icons_size: str
    font_hinting: str
    font_antialiasing: str
    font_rgba_order: str
    text_scaling_factor: float
    color_scheme: str
    event_sounds: bool
    input_feedback_sounds: bool


def gtk_log(message: str) -> None:
    elapsed = int(time.monotonic() - GTK_START)
    print(f"INFO[{elapsed:04d}] {message}")


def run_gsettings(args: list[str]) -> str:
    result = subprocess.run(["gsettings", *args], capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "gsettings failed")
    return result.stdout.strip()


def parse_gsettings_value(raw: str) -> str:
    if raw.startswith("'") and raw.endswith("'"):
        return raw[1:-1]
    return raw


def load_gtk_preferences() -> GtkPreferences:
    keys = [
        "gtk-theme", "icon-theme", "font-name", "cursor-theme", "cursor-size",
        "toolbar-style", "toolbar-icons-size", "font-hinting", "font-antialiasing",
        "font-rgba-order", "text-scaling-factor",
    ]
    interface = {k: parse_gsettings_value(run_gsettings(["get", "org.gnome.desktop.interface", k])) for k in keys}
    sounds = {k: parse_gsettings_value(run_gsettings(["get", "org.gnome.desktop.sound", k])) for k in ["event-sounds", "input-feedback-sounds"]}
    return GtkPreferences(
        gtk_theme=interface["gtk-theme"], icon_theme=interface["icon-theme"], font_name=interface["font-name"],
        cursor_theme=interface["cursor-theme"], cursor_size=int(float(interface["cursor-size"])),
        toolbar_style=interface["toolbar-style"], toolbar_icons_size=interface["toolbar-icons-size"],
        font_hinting=interface["font-hinting"], font_antialiasing=interface["font-antialiasing"],
        font_rgba_order=interface["font-rgba-order"], text_scaling_factor=float(interface["text-scaling-factor"]),
        color_scheme="default", event_sounds=sounds["event-sounds"] == "true", input_feedback_sounds=sounds["input-feedback-sounds"] == "true",
    )


def gtk_profile(mode: str) -> tuple[str, str, str]:
    if mode == "dark":
        return "Yaru-blue-dark", "Papirus-Dark", "prefer-dark"
    if mode == "light":
        return "Yaru-blue", "Papirus-Light", "prefer-light"
    raise ValueError(f"Unsupported mode: {mode}")


def apply_gtk_profile(mode: str) -> GtkPreferences:
    gtk_theme, icon_theme, color_scheme = gtk_profile(mode)
    prefs = load_gtk_preferences()
    prefs.gtk_theme = gtk_theme
    prefs.icon_theme = icon_theme
    prefs.color_scheme = color_scheme
    return prefs


def gvariant_str(value: str) -> str:
    return "'" + value.replace("'", "\\'") + "'"


def gvariant_bool(value: bool) -> str:
    return "true" if value else "false"


def apply_gsettings_gtk(prefs: GtkPreferences) -> None:
    gtk_log(">>> Applying gsettings")
    interface = [
        ("gtk-theme", gvariant_str(prefs.gtk_theme)), ("icon-theme", gvariant_str(prefs.icon_theme)),
        ("cursor-theme", gvariant_str(prefs.cursor_theme)), ("cursor-size", str(prefs.cursor_size)),
        ("font-name", gvariant_str(prefs.font_name)), ("font-hinting", gvariant_str(prefs.font_hinting)),
        ("font-antialiasing", gvariant_str(prefs.font_antialiasing)), ("font-rgba-order", gvariant_str(prefs.font_rgba_order)),
        ("text-scaling-factor", str(prefs.text_scaling_factor)), ("toolbar-style", gvariant_str(prefs.toolbar_style)),
        ("toolbar-icons-size", gvariant_str(prefs.toolbar_icons_size)), ("color-scheme", gvariant_str(prefs.color_scheme)),
    ]
    gtk_log(">> org.gnome.desktop.interface")
    for key, value in interface:
        run_gsettings(["set", "org.gnome.desktop.interface", key, value])
    for key, value in [("event-sounds", gvariant_bool(prefs.event_sounds)), ("input-feedback-sounds", gvariant_bool(prefs.input_feedback_sounds))]:
        run_gsettings(["set", "org.gnome.desktop.sound", key, value])


def gtk_bool_to_int(value: bool) -> int:
    return 1 if value else 0


def gtk_toolbar_style(style: str) -> str:
    return {"both-horiz": "GTK_TOOLBAR_BOTH_HORIZ", "both": "GTK_TOOLBAR_BOTH", "icons": "GTK_TOOLBAR_ICONS", "text": "GTK_TOOLBAR_TEXT"}.get(style, "GTK_TOOLBAR_ICONS")


def gtk_toolbar_icon_size(size: str) -> str:
    return {"small": "GTK_ICON_SIZE_SMALL_TOOLBAR", "large": "GTK_ICON_SIZE_LARGE_TOOLBAR"}.get(size, "GTK_ICON_SIZE_LARGE_TOOLBAR")


def xft_antialias(value: str) -> int:
    return 0 if value == "none" else 1


def xft_hinting(value: str) -> int:
    return 0 if value in {"none", ""} else 1


def xft_hintstyle(value: str) -> str:
    if value == "none":
        return "hintnone"
    return f"hint{value}"


def write_gtk_file(path: Path, lines: list[str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n")
    gtk_log(f">>> Exporting {path}")


def export_gtk_files(prefs: GtkPreferences) -> None:
    write_gtk_file(Path.home() / ".config/gtk-3.0/settings.ini", ["[Settings]", f"gtk-theme-name={prefs.gtk_theme}", f"gtk-icon-theme-name={prefs.icon_theme}", f"gtk-font-name={prefs.font_name}", f"gtk-cursor-theme-name={prefs.cursor_theme}", f"gtk-cursor-theme-size={prefs.cursor_size}", f"gtk-toolbar-style={gtk_toolbar_style(prefs.toolbar_style)}", f"gtk-toolbar-icon-size={gtk_toolbar_icon_size(prefs.toolbar_icons_size)}", "gtk-button-images=0", "gtk-menu-images=0", f"gtk-enable-event-sounds={gtk_bool_to_int(prefs.event_sounds)}", f"gtk-enable-input-feedback-sounds={gtk_bool_to_int(prefs.input_feedback_sounds)}", f"gtk-xft-antialias={xft_antialias(prefs.font_antialiasing)}", f"gtk-xft-hinting={xft_hinting(prefs.font_hinting)}", f"gtk-xft-hintstyle={xft_hintstyle(prefs.font_hinting)}", f"gtk-xft-rgba={prefs.font_rgba_order}", f"gtk-application-prefer-dark-theme={1 if prefs.color_scheme == 'prefer-dark' else 0}"])
    write_gtk_file(Path.home() / ".gtkrc-2.0", ["# DO NOT EDIT! This file will be overwritten by teme.", "# Any customization should be done in ~/.gtkrc-2.0.mine instead.", "", f'include "{Path.home()}/.gtkrc-2.0.mine"', f'gtk-theme-name="{prefs.gtk_theme}"', f'gtk-icon-theme-name="{prefs.icon_theme}"', f'gtk-font-name="{prefs.font_name}"', f'gtk-cursor-theme-name="{prefs.cursor_theme}"', f"gtk-cursor-theme-size={prefs.cursor_size}", f"gtk-toolbar-style={gtk_toolbar_style(prefs.toolbar_style)}", f"gtk-toolbar-icon-size={gtk_toolbar_icon_size(prefs.toolbar_icons_size)}", "gtk-button-images=0", "gtk-menu-images=0", f"gtk-enable-event-sounds={gtk_bool_to_int(prefs.event_sounds)}", f"gtk-enable-input-feedback-sounds={gtk_bool_to_int(prefs.input_feedback_sounds)}", f"gtk-xft-antialias={xft_antialias(prefs.font_antialiasing)}", f"gtk-xft-hinting={xft_hinting(prefs.font_hinting)}", f'gtk-xft-hintstyle="{xft_hintstyle(prefs.font_hinting)}"', f'gtk-xft-rgba="{prefs.font_rgba_order}"'])
    write_gtk_file(Path.home() / ".icons/default/index.theme", ["# This file is written by teme. Do not edit.", "[Icon Theme]", "Name=Default", "Comment=Default Cursor Theme", f"Inherits={prefs.cursor_theme}"])
    write_gtk_file(Path.home() / ".config/xsettingsd/xsettingsd.conf", [f'Net/ThemeName "{prefs.gtk_theme}"', f'Net/IconThemeName "{prefs.icon_theme}"', f'Gtk/CursorThemeName "{prefs.cursor_theme}"', f"Net/EnableEventSounds {gtk_bool_to_int(prefs.event_sounds)}", f"EnableInputFeedbackSounds {gtk_bool_to_int(prefs.input_feedback_sounds)}", f"Xft/Antialias {xft_antialias(prefs.font_antialiasing)}", f"Xft/Hinting {xft_hinting(prefs.font_hinting)}", f'Xft/HintStyle "{xft_hintstyle(prefs.font_hinting)}"', f'Xft/RGBA "{prefs.font_rgba_order}"'])
    write_gtk_file(Path.home() / ".config/gtk-4.0/settings.ini", ["[Settings]", f"gtk-theme-name={prefs.gtk_theme}", f"gtk-icon-theme-name={prefs.icon_theme}", f"gtk-font-name={prefs.font_name}", f"gtk-application-prefer-dark-theme={1 if prefs.color_scheme == 'prefer-dark' else 0}"])


def symlink_gtk4_css(prefs: GtkPreferences) -> None:
    source = Path("/usr/share/themes") / prefs.gtk_theme / "gtk-4.0"
    target = Path.home() / ".config/gtk-4.0"
    target.mkdir(parents=True, exist_ok=True)
    for file_name in ["gtk.css", "gtk-dark.css"]:
        dst = target / file_name
        src = source / file_name
        if dst.exists() or dst.is_symlink():
            dst.unlink()
        if src.exists():
            dst.symlink_to(src)
    gtk_log(f">>> Symlinking files in {target}")


def backup_gtk_prefs(prefs: GtkPreferences) -> None:
    backup_dir = Path.home() / ".local/share/nwg-look"
    backup_dir.mkdir(parents=True, exist_ok=True)
    (backup_dir / "gsettings.json").write_text(json.dumps(asdict(prefs), indent=2) + "\n")
    gtk_log(f">>> Backing up gsettings to {backup_dir}")


def log_gtk_prefs(prefs: GtkPreferences) -> None:
    gtk_log(f"lang: {os.environ.get('LANG', 'en_US')}")
    gtk_log(f"gtk-theme: {prefs.gtk_theme}")
    gtk_log(f"icon-theme: {prefs.icon_theme}")
    gtk_log(f"font-name: {prefs.font_name}")
    gtk_log(f"cursor-theme: {prefs.cursor_theme}")
    gtk_log(f"cursor-size: {prefs.cursor_size}")
    gtk_log(f"toolbar-style: {prefs.toolbar_style}")
    gtk_log(f"toolbar-icons-size: {prefs.toolbar_icons_size}")
    gtk_log(f"font-hinting: {prefs.font_hinting}")
    gtk_log(f"font-antialiasing: {prefs.font_antialiasing}")
    gtk_log(f"font-rgba-order: {prefs.font_rgba_order}")
    gtk_log(f"text-scaling-factor: {prefs.text_scaling_factor:g}")
    gtk_log(f"color-scheme: {prefs.color_scheme}")
    gtk_log(f"event-sounds: {str(prefs.event_sounds).lower()}")
    gtk_log(f"input-feedback-sounds: {str(prefs.input_feedback_sounds).lower()}")


def toggle_gtk(mode: str) -> None:
    gtk_log(">>> Loading preferences")
    gtk_log(">>> Reading gsettings")
    prefs = apply_gtk_profile(mode)
    log_gtk_prefs(prefs)
    gtk_log(">>> Parsing original ~/.config/gtk-3.0/settings.ini")
    apply_gsettings_gtk(prefs)
    backup_gtk_prefs(prefs)
    export_gtk_files(prefs)
    symlink_gtk4_css(prefs)

def _config_roots() -> list[Path]:
    candidates = [Path.home() / ".config", Path.home() / ".dotfiles/.config"]
    return [p for p in candidates if p.exists()]

def _theme_match(file: Path) -> re.Match[str] | None:
    pattern = r"^(?P<theme>.+)-(?P<mode>dark|light)(?P<ext>\..+)$"
    return re.match(pattern, file.name)


def _add_theme_file(by_theme: dict[str, dict[str, list[Path]]], file: Path) -> None:
    match = _theme_match(file)
    if not match:
        return
    theme = match.group("theme")
    mode = match.group("mode")
    by_theme.setdefault(theme, {}).setdefault(mode, []).append(file)


def _append_theme_pair(
    variants: dict[Path, dict[str, list[tuple[str, Path]]]],
    parent: Path,
    theme: str,
    modes: dict[str, list[Path]],
) -> None:
    if "dark" not in modes or "light" not in modes:
        return
    variants.setdefault(parent, {}).setdefault(theme, [])
    variants[parent][theme].extend(("dark", p) for p in modes["dark"])
    variants[parent][theme].extend(("light", p) for p in modes["light"])


def _collect_all_theme_variants() -> dict[Path, dict[str, list[tuple[str, Path]]]]:
    variants: dict[Path, dict[str, list[tuple[str, Path]]]] = {}
    for root in _config_roots():
        variants.update(_collect_theme_variants(root))
    return variants


def _collect_theme_variants(
    config_root: Path,
) -> dict[Path, dict[str, list[tuple[str, Path]]]]:
    variants: dict[Path, dict[str, list[tuple[str, Path]]]] = {}
    for colors_dir in config_root.rglob("colors"):
        _merge_colors_dir(variants, colors_dir)
    return variants


def _merge_colors_dir(
    variants: dict[Path, dict[str, list[tuple[str, Path]]]],
    colors_dir: Path,
) -> None:
    if not colors_dir.is_dir():
        return
    files = [p for p in colors_dir.iterdir() if p.is_file()]
    if not files:
        return
    by_theme: dict[str, dict[str, list[Path]]] = {}
    for file in files:
        _add_theme_file(by_theme, file)
    for theme, modes in by_theme.items():
        _append_theme_pair(variants, colors_dir.parent, theme, modes)


def _theme_names(variants: dict[Path, dict[str, list[tuple[str, Path]]]]) -> list[str]:
    return sorted({theme for per_dir in variants.values() for theme in per_dir})


def _print_lines(header: str, lines: list[str]) -> None:
    print(header)
    for line in lines:
        print(line)


def list_themes() -> None:
    themes = _theme_names(_collect_all_theme_variants())
    if not themes:
        print("No themes found")
        return
    _print_lines("Available themes:", themes)


def list_font_presets() -> None:
    _print_lines("Available font presets:", sorted(FONT_PRESETS))


def _update_file_with_regex(path: Path, pattern: str, replacement: str) -> bool:
    if not path.exists():
        raise FileNotFoundError(f"{path} not found")
    text = path.read_text()
    updated, count = re.subn(pattern, replacement, text, flags=re.MULTILINE)
    if count == 0:
        return False
    path.write_text(updated)
    return True


def _require_font_preset(preset: str) -> dict[str, str | int | float]:
    fonts = FONT_PRESETS.get(preset)
    if fonts:
        return fonts
    available = ", ".join(sorted(FONT_PRESETS))
    raise ValueError(f"Unknown font preset '{preset}'. Available: {available}")


def _font_updates(fonts: dict[str, str | int | float]) -> list[tuple[Path, str, str]]:
    return [
        (
            Path.home() / ".config/alacritty/alacritty.toml",
            r'^(\s*(?:normal|bold|italic|bold_italic)\s*=\s*\{\s*family\s*=\s*")[^"]+("\s*,\s*style\s*=\s*"[^"]+"\s*\})$',
            r"\g<1>" + str(fonts["alacritty"]) + r"\g<2>",
        ),
        (
            Path.home() / ".config/alacritty/alacritty.toml",
            r"^(\s*size\s*=\s*).+$",
            r"\g<1>" + str(fonts["alacritty_size"]),
        ),
        (
            Path.home() / ".config/i3/config",
            r"^font\s+pango:.+$",
            f"font pango:{fonts['i3']}",
        ),
        (
            Path.home() / ".config/mpv/mpv.conf",
            r'^(osd-font=")[^"]+(")$',
            r"\g<1>" + str(fonts["mpv"]) + r"\g<2>",
        ),
        (
            Path.home() / ".config/mpv/mpv.conf",
            r"^(osd-font-size=).+$",
            r"\g<1>" + str(fonts["mpv_osd_size"]),
        ),
        (
            Path.home() / ".config/mpv/mpv.conf",
            r'^(sub-font=")[^"]+(")$',
            r"\g<1>" + str(fonts["mpv"]) + r"\g<2>",
        ),
        (
            Path.home() / ".config/mpv/mpv.conf",
            r"^(sub-font-size=).+$",
            r"\g<1>" + str(fonts["mpv_sub_size"]),
        ),
        (
            Path.home() / ".config/zathura/zathurarc",
            r'^(set\s+font\s+")[^"]+(")$',
            r"\g<1>" + str(fonts["zathura"]) + r"\g<2>",
        ),
        (
            Path.home() / ".config/emacs/init.el",
            r'^(\s*:family\s+")[^"]+(")$',
            r"\g<1>" + str(fonts["emacs"]) + r"\g<2>",
        ),
        (
            Path.home() / ".config/emacs/init.el",
            r"^(\s*:height\s+)\d+(\)?)$",
            r"\g<1>" + str(fonts["emacs_height"]) + r"\g<2>",
        ),
        (
            Path.home() / ".config/rofi/config.rasi",
            r'^(\s*font:\s*")[^"]+(")\s*;$',
            r"\g<1>" + str(fonts["rofi"]) + r"\g<2>;",
        ),
    ]


def _apply_font_update(path: Path, pattern: str, replacement: str) -> bool:
    changed = _update_file_with_regex(path, pattern, replacement)
    print(f"Updated {path}" if changed else f"No match in {path}")
    return changed


def set_fonts(preset: str) -> None:
    touched = 0
    for path, pattern, replacement in _font_updates(_require_font_preset(preset)):
        touched += int(_apply_font_update(path, pattern, replacement))
    if touched == 0:
        raise RuntimeError("No font settings were updated")
    print(f"Applied font preset '{preset}'")


def _theme_target(parent: Path, siblings: list[Path], src: Path, mode: str) -> Path:
    matches = [p for p in siblings if p.suffix == src.suffix and mode in p.name.lower()]
    if len(matches) == 1:
        return matches[0]
    target = parent / f"{mode}{src.suffix}"
    if target.exists():
        return target
    return parent / ("Dark" + src.suffix if mode == "dark" else "Light" + src.suffix)


def _apply_theme_files(
    parent: Path, themed_files: list[tuple[str, Path]], missing_targets: list[str]
) -> int:
    siblings = [p for p in parent.iterdir() if p.is_file()]
    changed = 0
    for mode, src in themed_files:
        changed += int(_copy_theme_file(parent, siblings, mode, src, missing_targets))
    return changed


def _copy_theme_file(
    parent: Path,
    siblings: list[Path],
    mode: str,
    src: Path,
    missing_targets: list[str],
) -> bool:
    target = _theme_target(parent, siblings, src, mode)
    if not target.exists():
        missing_targets.append(str(parent))
        return False
    shutil.copyfile(src, target)
    print(f"{src} -> {target}")
    return True


def _report_missing_targets(missing_targets: list[str]) -> None:
    if not missing_targets:
        return
    print("Skipped directories without a matching dark/light target file:")
    for directory in sorted(set(missing_targets)):
        print(directory)


def apply_theme(theme: str) -> None:
    changed = 0
    missing_targets: list[str] = []
    for parent, per_theme in _collect_all_theme_variants().items():
        changed += _apply_theme_for_parent(parent, per_theme, theme, missing_targets)
    if changed == 0:
        raise ValueError(f"Theme not found or no files updated: {theme}")
    _report_missing_targets(missing_targets)
    print(f"Applied theme '{theme}' to {changed} file(s)")


def _apply_theme_for_parent(
    parent: Path,
    per_theme: dict[str, list[tuple[str, Path]]],
    theme: str,
    missing_targets: list[str],
) -> int:
    themed_files = per_theme.get(theme)
    if not themed_files:
        return 0
    return _apply_theme_files(parent, themed_files, missing_targets)


def _toggle_mapping(
    text: str,
    light_to_dark: dict[str, str],
    detect_light: str,
) -> tuple[dict[str, str], str, str]:
    if detect_light in text:
        return light_to_dark, "light", "dark"
    return {v: k for k, v in light_to_dark.items()}, "dark", "light"


def _replace_all(text: str, mapping: dict[str, str]) -> str:
    updated = text
    for src, dst in mapping.items():
        updated = updated.replace(src, dst)
    return updated


def toggle_config(
    path: Path,
    light_to_dark: dict[str, str],
    detect_light: str,
) -> tuple[str, str]:
    if not path.exists():
        raise FileNotFoundError(f"{path} not found")
    text = path.read_text()
    mapping, old_mode, new_mode = _toggle_mapping(text, light_to_dark, detect_light)
    path.write_text(_replace_all(text, mapping))
    return old_mode, new_mode


def run_text_toggle(
    path: Path,
    light_to_dark: dict[str, str],
) -> str:
    old, new = toggle_config(
        path=path, light_to_dark=light_to_dark, detect_light=next(iter(light_to_dark))
    )
    print(f"{path}: {old} => {new}")
    return new


def _mode_source(
    current: str,
    detect_light: str,
    light_path: Path,
    dark_path: Path,
) -> tuple[Path, str, str]:
    if detect_light in current:
        return dark_path, "light", "dark"
    return light_path, "dark", "light"


def toggle_marker_section(
    config_path: Path,
    light_path: Path,
    dark_path: Path,
    marker: str,
) -> str:
    if not config_path.exists():
        raise FileNotFoundError(f"{config_path} not found")
    if not light_path.exists() or not dark_path.exists():
        raise FileNotFoundError(f"Theme files missing for {config_path}")
    text = config_path.read_text()
    if marker not in text:
        raise RuntimeError(f"Theme marker not found in {config_path}")
    head, current = text.split(marker, 1)
    theme_file, old, new = _mode_source(current, "# Light", light_path, dark_path)
    new_config = (
        head.rstrip()
        + "\n\n"
        + marker
        + "\n\n"
        + theme_file.read_text().rstrip()
        + "\n"
    )
    config_path.write_text(new_config)
    print(f"{config_path}: {old} => {new}")
    return new


def toggle_bashrc() -> str:
    return run_text_toggle(
        path=Path.home() / ".bashrc",
        light_to_dark={"fzf/light.sh": "fzf/dark.sh", "--theme=Light": "--theme=Dark"},
    )


def toggle_nvim() -> None:
    run_text_toggle(
        path=Path.home() / ".config/nvim/lua/options.lua",
        light_to_dark={'o.background = "light"': 'o.background = "dark"'},
    )


def toggle_vim() -> None:
    run_text_toggle(
        path=Path.home() / ".vimrc",
        light_to_dark={"set background=light": "set background=dark"},
    )


def toggle_emacs() -> None:
    run_text_toggle(
        path=Path.home() / ".config/emacs/init.el",
        light_to_dark={
            "(load-theme 'modus-operandi t)": "(load-theme 'modus-vivendi t)"
        },
    )


def restart_emacs_daemon() -> None:
    subprocess.run(["killall", "emacs"], check=False)
    subprocess.run(["emacs", "--daemon"], check=True)
    print("Emacs daemon restarted")


def toggle_alacritty() -> None:
    run_text_toggle(
        path=Path.home() / ".config/alacritty/alacritty.toml",
        light_to_dark={"light.toml": "dark.toml"},
    )


def toggle_dunst() -> None:
    dunst_dir = Path.home() / ".config/dunst"
    target_path=dunst_dir / "dunstrc"
    light_path=dunst_dir / "themes/light.conf"
    dark_path=dunst_dir / "themes/dark.conf"
    detect_light="theme: light"
    restart_command=["killall", "dunst"]
    if not target_path.exists():
        raise FileNotFoundError(f"{target_path} not found")
    if not light_path.exists() or not dark_path.exists():
        raise FileNotFoundError(f"Theme files missing for {dunst_dir}")
    src, old, new = _mode_source(
        target_path.read_text(), detect_light, light_path, dark_path
    )
    shutil.copyfile(src, target_path)
    if restart_command:
        subprocess.run(restart_command, check=False)
    print(f"{dunst_dir}: {old} => {new}")


def toggle_i3() -> None:
    i3_dir = Path.home() / ".config/i3"
    toggle_marker_section(
        config_path=i3_dir / "config",
        light_path=i3_dir / "light.conf",
        dark_path=i3_dir / "dark.conf",
        marker="# Theme: Auto-script switcher",
    )


def toggle_zathura() -> None:
    zathura_dir = Path.home() / ".config/zathura"
    toggle_marker_section(
        config_path=zathura_dir / "zathurarc",
        light_path=zathura_dir / "light.zathurarc",
        dark_path=zathura_dir / "dark.zathurarc",
        marker="# Theme: Auto-script switcher",
    )


def toggle_rofi() -> None:
    run_text_toggle(
        path=Path.home() / ".config/rofi/config.rasi",
        light_to_dark={'@import "light"': '@import "dark"'},
    )


def toggle_opencode(mode: str) -> None:
    opencode_config = Path.home() / ".config/opencode/tui.json"
    if not opencode_config.exists():
        raise FileNotFoundError(f"{opencode_config} not found")
    theme = {"dark": "dark", "light": "light"}.get(mode)
    if theme is None:
        raise ValueError(f"Unsupported mode: {mode}")
    config = json.loads(opencode_config.read_text())
    old_theme = config.get("theme", "<unset>")
    config["theme"] = theme
    opencode_config.write_text(json.dumps(config, indent=2) + "\n")
    print(f"~/.config/opencode/tui.json: {old_theme} => {theme}")


def set_wallpaper(mode: str) -> None:
    wallpaper_dir = Path.home() / ".config/wallpaper"
    wallpaper = {
        "light": wallpaper_dir / "light.jpg",
        "dark": wallpaper_dir / "dark.jpg",
    }.get(mode)
    if not wallpaper or not wallpaper.exists():
        raise FileNotFoundError(f"Wallpaper not found for mode: {mode}")
    shutil.copyfile(wallpaper, wallpaper_dir / "current.jpg")
    shutil.copyfile(wallpaper, wallpaper_dir / "colors" / "current.jpg")
    script = Path.home() / ".screenlayout/set-screens.sh"
    if not script.exists():
        raise FileNotFoundError(f"Screen layout script not found: {script}")
    subprocess.run([str(script)], check=True)
    print(f"Wallpaper set: {mode} -> {wallpaper_dir / 'current.jpg'}")


def rebuild_bat_cache() -> None:
    subprocess.run(["bat", "cache", "--build"], check=True)
    print("bat cache rebuilt")


def reset_terminal_sessions() -> None:
    subprocess.run(["killall", "alacritty"], check=False)
    subprocess.run(["tmux", "kill-server"], check=False)
    print("Reset terminal sessions: killed alacritty and tmux server")


def _parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("-t", "--theme", help="Theme name, or 'ls' to list themes")
    parser.add_argument(
        "-f", "--fonts", help="Font preset name, or 'ls' to list presets"
    )
    parser.add_argument(
        "--confirm",
        action="store_true",
        help="Ask for confirmation in rofi before running",
    )
    return parser.parse_args()


def _confirm_with_rofi(prompt: str) -> bool:
    result = subprocess.run(
        ["rofi", "-dmenu", "-i", "-p", prompt],
        input="no\nyes\n",
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return False
    return result.stdout.strip().lower() == "yes"


def _confirm_prompt(args: argparse.Namespace) -> str:
    if args.theme and args.fonts:
        return f"Run theme '{args.theme}' and fonts '{args.fonts}'?"
    if args.theme:
        return f"Run theme '{args.theme}'?"
    if args.fonts:
        return f"Run fonts '{args.fonts}'?"
    return "Run full theme toggle?"


def _run_theme_command(theme: str) -> None:
    if theme == "ls":
        list_themes()
    if theme != "ls":
        apply_theme(theme)


def _run_font_command(fonts: str) -> None:
    if fonts == "ls":
        list_font_presets()
    if fonts != "ls":
        set_fonts(fonts)


def _handle_cli_actions(args: argparse.Namespace) -> bool:
    if not args.theme and not args.fonts:
        return False
    if args.theme:
        _run_theme_command(args.theme)
    if args.fonts:
        _run_font_command(args.fonts)
    return True


def _run_full_toggle(mode: str) -> None:
    toggle_nvim()
    toggle_vim()
    toggle_emacs()
    restart_emacs_daemon()
    toggle_alacritty()
    toggle_dunst()
    toggle_i3()
    toggle_zathura()
    toggle_rofi()
    toggle_opencode(mode)
    set_wallpaper(mode)
    toggle_gtk(mode)
    rebuild_bat_cache()


def main() -> None:
    args = _parse_args()
    if args.confirm and not _confirm_with_rofi(_confirm_prompt(args)):
        print("Cancelled")
        return
    if _handle_cli_actions(args):
        return
    mode = toggle_bashrc()
    _run_full_toggle(mode)
    reset_terminal_sessions()


if __name__ == "__main__":
    main()
