#!/usr/bin/env python3
import argparse
import json
import re
import shutil
import subprocess
from pathlib import Path


def _config_roots() -> list[Path]:
    candidates = [Path.home() / ".config", Path.home() / ".dotfiles/.config"]
    return [p for p in candidates if p.exists()]


FONT_PRESETS: dict[str, dict[str, str]] = {
    "Gohu": {
        "alacritty": "GohuFont 14 Nerd Font Mono",
        "i3": "GohuFont 14 Nerd Font Mono 14",
        "mpv": "GohuFont 14 Nerd Font Mono",
        "zathura": "GohuFont uni14 Nerd Font Mono 14",
        "emacs": "GohuFont 14 Nerd Font Mono",
        "rofi": "GohuFont 14 Nerd Font Mono 14",
    },
    "DejaVu": {
        "alacritty": "DejaVuSansM Nerd Font Mono",
        "i3": "DejaVuSansM Nerd Font Mono 16",
        "mpv": "DejaVuSansM Nerd Font Mono",
        "zathura": "DejaVuSansM Nerd Font Mono 16",
        "emacs": "DejaVuSansM Nerd Font Mono",
        "rofi": "DejaVuSansM Nerd Font Mono 16",
    },
}


def _collect_all_theme_variants() -> dict[Path, dict[str, list[tuple[str, Path]]]]:
    variants: dict[Path, dict[str, list[tuple[str, Path]]]] = {}
    for root in _config_roots():
        variants.update(_collect_theme_variants(root))
    return variants


def _collect_theme_variants(config_root: Path) -> dict[Path, dict[str, list[tuple[str, Path]]]]:
    variants: dict[Path, dict[str, list[tuple[str, Path]]]] = {}

    for colors_dir in config_root.rglob("colors"):
        if not colors_dir.is_dir():
            continue

        files = [p for p in colors_dir.iterdir() if p.is_file()]
        if not files:
            continue

        parent = colors_dir.parent
        by_theme: dict[str, dict[str, list[Path]]] = {}

        for file in files:
            match = re.match(r"^(?P<theme>.+)-(?P<mode>dark|light)(?P<ext>\..+)$", file.name)
            if not match:
                continue
            theme = match.group("theme")
            mode = match.group("mode")
            by_theme.setdefault(theme, {}).setdefault(mode, []).append(file)

        for theme, modes in by_theme.items():
            if "dark" not in modes or "light" not in modes:
                continue
            variants.setdefault(parent, {}).setdefault(theme, [])
            variants[parent][theme].extend(("dark", p) for p in modes["dark"])
            variants[parent][theme].extend(("light", p) for p in modes["light"])

    return variants


def list_themes() -> None:
    variants = _collect_all_theme_variants()

    themes = sorted({theme for per_dir in variants.values() for theme in per_dir})
    if not themes:
        print("No themes found")
        return

    print("Available themes:")
    for theme in themes:
        print(theme)


def list_font_presets() -> None:
    print("Available font presets:")
    for preset in sorted(FONT_PRESETS):
        print(preset)


def _update_file_with_regex(path: Path, pattern: str, replacement: str) -> bool:
    if not path.exists():
        raise FileNotFoundError(f"{path} not found")

    text = path.read_text()
    updated, count = re.subn(pattern, replacement, text, flags=re.MULTILINE)
    if count == 0:
        return False

    path.write_text(updated)
    return True


def set_fonts(preset: str) -> None:
    fonts = FONT_PRESETS.get(preset)
    if fonts is None:
        available = ", ".join(sorted(FONT_PRESETS))
        raise ValueError(f"Unknown font preset '{preset}'. Available: {available}")

    updates: list[tuple[Path, str, str]] = [
        (
            Path.home() / ".config/alacritty/alacritty.toml",
            r'^(\s*(?:normal|bold|italic|bold_italic)\s*=\s*\{\s*family\s*=\s*")[^"]+("\s*,\s*style\s*=\s*"[^"]+"\s*\})$',
            rf'\1{fonts["alacritty"]}\2',
        ),
        (
            Path.home() / ".config/i3/config",
            r'^font\s+pango:.+$',
            f'font pango:{fonts["i3"]}',
        ),
        (
            Path.home() / ".config/mpv/mpv.conf",
            r'^(osd-font=")[^"]+(")$',
            rf'\1{fonts["mpv"]}\2',
        ),
        (
            Path.home() / ".config/mpv/mpv.conf",
            r'^(sub-font=")[^"]+(")$',
            rf'\1{fonts["mpv"]}\2',
        ),
        (
            Path.home() / ".config/zathura/zathurarc",
            r'^(set\s+font\s+")[^"]+(")$',
            rf'\1{fonts["zathura"]}\2',
        ),
        (
            Path.home() / ".config/emacs/init.el",
            r'^(\s*:family\s+")[^"]+(")$',
            rf'\1{fonts["emacs"]}\2',
        ),
        (
            Path.home() / ".config/rofi/config.rasi",
            r'^(\s*font:\s*")[^"]+(")\s*;$',
            rf'\1{fonts["rofi"]}\2;',
        ),
    ]

    touched = 0
    for path, pattern, replacement in updates:
        changed = _update_file_with_regex(path, pattern, replacement)
        if changed:
            touched += 1
            print(f"Updated {path}")
        else:
            print(f"No match in {path}")

    if touched == 0:
        raise RuntimeError("No font settings were updated")

    print(f"Applied font preset '{preset}'")


def apply_theme(theme: str) -> None:
    variants = _collect_all_theme_variants()

    changed = 0
    missing_targets: list[str] = []

    for parent, per_theme in variants.items():
        themed_files = per_theme.get(theme)
        if not themed_files:
            continue

        sibling_files = [p for p in parent.iterdir() if p.is_file()]

        for mode, src in themed_files:
            same_ext = [p for p in sibling_files if p.suffix == src.suffix and mode in p.name.lower()]
            if len(same_ext) == 1:
                target = same_ext[0]
            else:
                target = parent / f"{mode}{src.suffix}"
                if not target.exists():
                    fallback = parent / ("Dark" + src.suffix if mode == "dark" else "Light" + src.suffix)
                    if fallback.exists():
                        target = fallback

            if not target.exists():
                missing_targets.append(str(parent))
                continue

            shutil.copyfile(src, target)
            changed += 1
            print(f"{src} -> {target}")

    if changed == 0:
        raise ValueError(f"Theme not found or no files updated: {theme}")

    if missing_targets:
        uniq = sorted(set(missing_targets))
        print("Skipped directories without a matching dark/light target file:")
        for d in uniq:
            print(d)

    print(f"Applied theme '{theme}' to {changed} file(s)")


def toggle_config(
    path: Path,
    light_to_dark: dict[str, str],
    detect_light: str,
) -> tuple[str, str]:
    """Toggle the theme mode in the config at the path given

    Args:
        path: path to config file
        light_to_dark: mapping from light to dark
        detect_light: detecting if we are in light mode
    Returns:
        (old_mode, new_mode)

    Raises:
        FileNotFoundError: If the config file does not exist
    """
    if not path.exists():
        raise FileNotFoundError(f"{path} not found")

    text = path.read_text()

    if detect_light in text:
        mapping = light_to_dark
        old_mode, new_mode = "light", "dark"
    else:
        mapping = {v: k for k, v in light_to_dark.items()}
        old_mode, new_mode = "dark", "light"

    for src, dst in mapping.items():
        text = text.replace(src, dst)

    path.write_text(text)
    return old_mode, new_mode


def run_text_toggle(
    label: str,
    path: Path,
    light_to_dark: dict[str, str],
    detect_light: str,
) -> str:
    old, new = toggle_config(
        path=path,
        light_to_dark=light_to_dark,
        detect_light=detect_light,
    )
    print(f"{label}: {old} => {new}")
    return new


def toggle_whole_file(
    label: str,
    target_path: Path,
    light_path: Path,
    dark_path: Path,
    detect_light: str,
    restart_command: list[str] | None = None,
) -> str:
    if not target_path.exists():
        raise FileNotFoundError(f"{target_path} not found")
    if not light_path.exists() or not dark_path.exists():
        raise FileNotFoundError(f"Theme files missing for {label}")

    current = target_path.read_text()
    if detect_light in current:
        src = dark_path
        old, new = "light", "dark"
    else:
        src = light_path
        old, new = "dark", "light"

    shutil.copyfile(src, target_path)
    if restart_command:
        subprocess.run(restart_command, check=False)

    print(f"{label}: {old} => {new}")
    return new


def toggle_marker_section(
    label: str,
    config_path: Path,
    light_path: Path,
    dark_path: Path,
    marker: str,
) -> str:
    if not config_path.exists():
        raise FileNotFoundError(f"{config_path} not found")
    if not light_path.exists() or not dark_path.exists():
        raise FileNotFoundError(f"Theme files missing for {label}")

    text = config_path.read_text()
    if marker not in text:
        raise RuntimeError(f"Theme marker not found in {label}")

    head, current_theme = text.split(marker, 1)

    if "# Light" in current_theme:
        theme_file = dark_path
        old, new = "light", "dark"
    else:
        theme_file = light_path
        old, new = "dark", "light"

    new_theme = theme_file.read_text().rstrip()
    new_config = head.rstrip() + "\n\n" + marker + "\n\n" + new_theme + "\n"
    config_path.write_text(new_config)

    print(f"{label}: {old} => {new}")
    return new


def toggle_bashrc() -> str:
    return run_text_toggle(
        label="~/.bashrc",
        path=Path.home() / ".bashrc",
        light_to_dark={
            "fzf/light.sh": "fzf/dark.sh",
            "--theme=Light": "--theme=Dark",
        },
        detect_light="fzf/light.sh",
    )


def toggle_nvim() -> None:
    run_text_toggle(
        label="~/.config/nvim/lua/options.lua",
        path=Path.home() / ".config/nvim/lua/options.lua",
        light_to_dark={'o.background = "light"': 'o.background = "dark"'},
        detect_light='o.background = "light"',
    )


def toggle_vim() -> None:
    run_text_toggle(
        label="~/.vimrc",
        path=Path.home() / ".vimrc",
        light_to_dark={"set background=light": "set background=dark"},
        detect_light="set background=light",
    )


def toggle_emacs() -> None:
    light_theme = "(load-theme 'modus-operandi t)"
    run_text_toggle(
        label="~/.config/emacs/init.el",
        path=Path.home() / ".config/emacs/init.el",
        light_to_dark={light_theme: "(load-theme 'modus-vivendi t)"},
        detect_light=light_theme,
    )


def restart_emacs_daemon() -> None:
    subprocess.run(["killall", "emacs"], check=False)
    subprocess.run(["emacs", "--daemon"], check=True)
    print("Emacs daemon restarted")


def toggle_alacritty() -> None:
    run_text_toggle(
        label="~/.config/alacritty/alacritty.toml",
        path=Path.home() / ".config/alacritty/alacritty.toml",
        light_to_dark={"light.toml": "dark.toml"},
        detect_light="light.toml",
    )


def toggle_dunst() -> None:
    dunst_dir = Path.home() / ".config/dunst"
    toggle_whole_file(
        label="~/.config/dunst/dunstrc",
        target_path=dunst_dir / "dunstrc",
        light_path=dunst_dir / "themes/light.conf",
        dark_path=dunst_dir / "themes/dark.conf",
        detect_light="theme: light",
        restart_command=["killall", "dunst"],
    )


def toggle_i3() -> None:
    i3_dir = Path.home() / ".config/i3"
    toggle_marker_section(
        label="~/.config/i3/config",
        config_path=i3_dir / "config",
        light_path=i3_dir / "light.conf",
        dark_path=i3_dir / "dark.conf",
        marker="# Theme: Auto-script switcher",
    )


def toggle_zathura() -> None:
    zathura_dir = Path.home() / ".config/zathura"
    toggle_marker_section(
        label="~/.config/zathura/zathurarc",
        config_path=zathura_dir / "zathurarc",
        light_path=zathura_dir / "light.zathurarc",
        dark_path=zathura_dir / "dark.zathurarc",
        marker="# Theme: Auto-script switcher",
    )


def toggle_rofi() -> None:
    run_text_toggle(
        label="~/.config/rofi/config.rasi",
        path=Path.home() / ".config/rofi/config.rasi",
        light_to_dark={'@import "light"': '@import "dark"'},
        detect_light='@import "light"',
    )


def toggle_opencode(mode: str) -> None:
    opencode_config: Path = Path.home() / ".config/opencode/tui.json"

    if not opencode_config.exists():
        raise FileNotFoundError(f"{opencode_config} not found")

    theme_by_mode = {
        "dark": "dark",
        "light": "light",
    }

    theme = theme_by_mode.get(mode)
    if theme is None:
        raise ValueError(f"Unsupported mode: {mode}")

    config = json.loads(opencode_config.read_text())
    old_theme = config.get("theme", "<unset>")
    config["theme"] = theme
    opencode_config.write_text(json.dumps(config, indent=2) + "\n")

    print(f"~/.config/opencode/tui.json: {old_theme} => {theme}")


def set_wallpaper(mode: str) -> None:
    wallpaper_dir = Path.home() / ".config/wallpaper"

    wallpapers = {
        "light": wallpaper_dir / "light.jpg",
        "dark": wallpaper_dir / "dark.jpg",
    }

    wallpaper = wallpapers.get(mode)
    if not wallpaper or not wallpaper.exists():
        raise FileNotFoundError(f"Wallpaper not found for mode: {mode}")

    current = wallpaper_dir / "current.jpg"
    current_solid = wallpaper_dir / "colors" / "current.jpg"
    shutil.copyfile(wallpaper, current)
    shutil.copyfile(wallpaper, current_solid)

    screenlayout_script = Path.home() / ".screenlayout/set-screens.sh"

    if not screenlayout_script.exists():
        raise FileNotFoundError(
            f"Screen layout script not found: {screenlayout_script}"
        )

    subprocess.run(
        [str(screenlayout_script)],
        check=True,
    )

    print(f"Wallpaper set: {mode} → {current}")


def set_color_scheme() -> None:
    subprocess.run(["nwg-look"], check=True)


def rebuild_bat_cache() -> None:
    subprocess.run(["bat", "cache", "--build"], check=True)
    print("bat cache rebuilt")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("-t", "--theme", help="Theme name, or 'ls' to list themes")
    parser.add_argument("-f", "--fonts", help="Font preset name, or 'ls' to list presets")
    args = parser.parse_args()

    if args.theme:
        if args.theme == "ls":
            list_themes()
        else:
            apply_theme(args.theme)
        return

    if args.fonts:
        if args.fonts == "ls":
            list_font_presets()
        else:
            set_fonts(args.fonts)
        return

    mode = toggle_bashrc()

    toggle_nvim()
    toggle_vim()
    toggle_emacs()
    restart_emacs_daemon()
    toggle_alacritty()
    toggle_dunst()
    toggle_i3()
    toggle_zathura()
    toggle_rofi()
    toggle_opencode(mode)
    set_wallpaper(mode)
    set_color_scheme()
    rebuild_bat_cache()


if __name__ == "__main__":
    main()
