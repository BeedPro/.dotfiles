#!/usr/bin/env python3
import argparse
import json
import re
import shutil
import subprocess
from pathlib import Path
from typing import Dict, Tuple


def _config_roots() -> list[Path]:
    candidates = [Path.home() / ".config", Path.home() / ".dotfiles/.config"]
    return [p for p in candidates if p.exists()]


def _collect_theme_variants(config_root: Path) -> dict[Path, dict[str, list[tuple[str, Path]]]]:
    variants: dict[Path, dict[str, list[tuple[str, Path]]]] = {}

    for colors_dir in config_root.rglob("colors"):
        if not colors_dir.is_dir():
            continue

        files = [p for p in colors_dir.iterdir() if p.is_file()]
        if not files:
            continue

        parent = colors_dir.parent
        by_theme: dict[str, dict[str, list[Path]]] = {}

        for file in files:
            match = re.match(r"^(?P<theme>.+)-(?P<mode>dark|light)(?P<ext>\..+)$", file.name)
            if not match:
                continue
            theme = match.group("theme")
            mode = match.group("mode")
            by_theme.setdefault(theme, {}).setdefault(mode, []).append(file)

        for theme, modes in by_theme.items():
            if "dark" not in modes or "light" not in modes:
                continue
            variants.setdefault(parent, {}).setdefault(theme, [])
            variants[parent][theme].extend(("dark", p) for p in modes["dark"])
            variants[parent][theme].extend(("light", p) for p in modes["light"])

    return variants


def list_themes() -> None:
    variants: dict[Path, dict[str, list[tuple[str, Path]]]] = {}
    for root in _config_roots():
        variants.update(_collect_theme_variants(root))

    themes = sorted({theme for per_dir in variants.values() for theme in per_dir})
    if not themes:
        print("No themes found")
        return

    print("Available themes:")
    for theme in themes:
        print(theme)


def apply_theme(theme: str) -> None:
    variants: dict[Path, dict[str, list[tuple[str, Path]]]] = {}
    for root in _config_roots():
        variants.update(_collect_theme_variants(root))

    changed = 0
    missing_targets: list[str] = []

    for parent, per_theme in variants.items():
        themed_files = per_theme.get(theme)
        if not themed_files:
            continue

        sibling_files = [p for p in parent.iterdir() if p.is_file()]

        for mode, src in themed_files:
            same_ext = [p for p in sibling_files if p.suffix == src.suffix and mode in p.name.lower()]
            if len(same_ext) == 1:
                target = same_ext[0]
            else:
                target = parent / f"{mode}{src.suffix}"
                if not target.exists():
                    fallback = parent / ("Dark" + src.suffix if mode == "dark" else "Light" + src.suffix)
                    if fallback.exists():
                        target = fallback

            if not target.exists():
                missing_targets.append(str(parent))
                continue

            shutil.copyfile(src, target)
            changed += 1
            print(f"{src} -> {target}")

    if changed == 0:
        raise ValueError(f"Theme not found or no files updated: {theme}")

    if missing_targets:
        uniq = sorted(set(missing_targets))
        print("Skipped directories without a matching dark/light target file:")
        for d in uniq:
            print(d)

    print(f"Applied theme '{theme}' to {changed} file(s)")


def toggle_config(
    path: Path,
    light_to_dark: Dict[str, str],
    detect_light: str,
) -> Tuple[str, str]:
    """Toggle the theme mode in the config at the path given

    Args:
        path: path to config file
        light_to_dark: mapping from light to dark
        detect_light: detecting if we are in light mode
    Returns:
        (old_mode, new_mode)

    Raises:
        FileNotFoundError: If the config file does not exist
    """
    if not path.exists():
        raise FileNotFoundError(f"{path} not found")

    text = path.read_text()

    if detect_light in text:
        mapping = light_to_dark
        old_mode, new_mode = "light", "dark"
    else:
        mapping = {v: k for k, v in light_to_dark.items()}
        old_mode, new_mode = "dark", "light"

    for src, dst in mapping.items():
        text = text.replace(src, dst)

    path.write_text(text)
    return old_mode, new_mode


def toggle_bashrc() -> str:
    bashrc: Path = Path.home() / ".bashrc"

    light_to_dark: dict[str, str] = {
        "fzf/light.sh": "fzf/dark.sh",
        "--theme=Light": "--theme=Dark",
    }

    old, new = toggle_config(
        path=bashrc,
        light_to_dark=light_to_dark,
        detect_light="fzf/light.sh",
    )

    print(f"~/.bashrc: {old} => {new}")
    return new


def toggle_nvim() -> None:
    nvim_config: Path = Path.home() / ".config/nvim/lua/options.lua"

    light_to_dark: dict[str, str] = {'o.background = "light"': 'o.background = "dark"'}

    old, new = toggle_config(
        path=nvim_config,
        light_to_dark=light_to_dark,
        detect_light='o.background = "light"',
    )

    print(f"~/.config/nvim/lua/options.lua: {old} => {new}")


def toggle_vim() -> None:
    vim_config: Path = Path.home() / ".vimrc"

    light_to_dark: dict[str, str] = {
        "set background=light": "set background=dark",
    }

    old, new = toggle_config(
        path=vim_config,
        light_to_dark=light_to_dark,
        detect_light="set background=light",
    )

    print(f"~/.vimrc: {old} => {new}")


def toggle_emacs() -> None:
    emacs_config: Path = Path.home() / ".config/emacs/init.el"

    light_theme: str = "(load-theme 'modus-operandi t)"

    light_to_dark: dict[str, str] = {
        light_theme : "(load-theme 'modus-vivendi t)",
    }

    old, new = toggle_config(
        path=emacs_config,
        light_to_dark=light_to_dark,
        detect_light=light_theme,
    )

    print(f"~/.config/emacs/init.el: {old} => {new}")


def restart_emacs_daemon() -> None:
    subprocess.run(["killall", "emacs"], check=False)
    subprocess.run(["emacs", "--daemon"], check=True)
    print("Emacs daemon restarted")


def toggle_alacritty() -> None:
    alacritty_config: Path = Path.home() / ".config/alacritty/alacritty.toml"

    light_to_dark: dict[str, str] = {"light.toml": "dark.toml"}

    old, new = toggle_config(
        path=alacritty_config,
        light_to_dark=light_to_dark,
        detect_light="light.toml",
    )

    print(f"~/.config/alacritty/alacritty.toml: {old} => {new}")


def toggle_dunst() -> None:
    dunst_dir: Path = Path.home() / ".config/dunst"
    dunstrc: Path = dunst_dir / "dunstrc"
    themes_dir: Path = dunst_dir / "themes"

    light_theme: Path = themes_dir / "light.conf"
    dark_theme: Path = themes_dir / "dark.conf"

    if not dunstrc.exists():
        raise FileNotFoundError("dunstrc not found")

    if not light_theme.exists() or not dark_theme.exists():
        raise FileNotFoundError("Dunst theme files missing")

    current = dunstrc.read_text()

    if "theme: light" in current:
        src = dark_theme
        old = "light"
        new = "dark"
    else:
        src = light_theme
        old = "dark"
        new = "light"

    shutil.copyfile(src, dunstrc)
    subprocess.run(["killall", "dunst"], check=False)
    print(f"~/.config/dunst/dunstrc: {old} => {new}")


def toggle_i3() -> None:
    i3_dir = Path.home() / ".config/i3"
    config = i3_dir / "config"

    light_theme = i3_dir / "light.conf"
    dark_theme = i3_dir / "dark.conf"

    if not config.exists():
        raise FileNotFoundError("i3 config not found")

    if not light_theme.exists() or not dark_theme.exists():
        raise FileNotFoundError("i3 theme files missing")

    text = config.read_text()

    marker = "# Theme: Auto-script switcher"
    if marker not in text:
        raise RuntimeError("Theme marker not found in i3 config")

    head, current_theme = text.split(marker, 1)

    if "# Light" in current_theme:
        theme_file = dark_theme
        old, new = "light", "dark"
    else:
        theme_file = light_theme
        old, new = "dark", "light"

    new_theme = theme_file.read_text().rstrip()

    new_config = head.rstrip() + "\n\n" + marker + "\n\n" + new_theme + "\n"

    config.write_text(new_config)

    print(f"~/.config/i3/config: {old} => {new}")


def toggle_zathura() -> None:
    zathura_dir = Path.home() / ".config/zathura"
    zathurarc = zathura_dir / "zathurarc"

    light_theme = zathura_dir / "light.zathurarc"
    dark_theme = zathura_dir / "dark.zathurarc"

    if not zathurarc.exists():
        raise FileNotFoundError("zathura config not found")

    if not light_theme.exists() or not dark_theme.exists():
        raise FileNotFoundError("Zathura theme files missing")

    text = zathurarc.read_text()

    marker = "# Theme: Auto-script switcher"
    if marker not in text:
        raise RuntimeError("Theme marker not found in zathura config")

    head, current_theme = text.split(marker, 1)

    if "# Light" in current_theme:
        theme_file = dark_theme
        old, new = "light", "dark"
    else:
        theme_file = light_theme
        old, new = "dark", "light"

    new_theme = theme_file.read_text().rstrip()
    new_config = head.rstrip() + "\n\n" + marker + "\n\n" + new_theme + "\n"

    zathurarc.write_text(new_config)

    print(f"~/.config/zathura/zathurarc: {old} => {new}")


def toggle_rofi() -> None:
    rofi_config: Path = Path.home() / ".config/rofi/config.rasi"

    light_to_dark: dict[str, str] = {'@import "light"': '@import "dark"'}

    old, new = toggle_config(
        path=rofi_config,
        light_to_dark=light_to_dark,
        detect_light='@import "light"',
    )

    print(f"~/.config/rofi/config.rasi: {old} => {new}")


def toggle_opencode(mode: str) -> None:
    opencode_config: Path = Path.home() / ".config/opencode/tui.json"

    if not opencode_config.exists():
        raise FileNotFoundError(f"{opencode_config} not found")

    theme_by_mode = {
        "dark": "dark",
        "light": "light",
    }

    theme = theme_by_mode.get(mode)
    if theme is None:
        raise ValueError(f"Unsupported mode: {mode}")

    config = json.loads(opencode_config.read_text())
    old_theme = config.get("theme", "<unset>")
    config["theme"] = theme
    opencode_config.write_text(json.dumps(config, indent=2) + "\n")

    print(f"~/.config/opencode/tui.json: {old_theme} => {theme}")


def set_wallpaper(mode: str) -> None:
    wallpaper_dir = Path.home() / ".config/wallpaper"

    wallpapers = {
        "light": wallpaper_dir / "light.jpg",
        "dark": wallpaper_dir / "dark.jpg",
    }

    wallpaper = wallpapers.get(mode)
    if not wallpaper or not wallpaper.exists():
        raise FileNotFoundError(f"Wallpaper not found for mode: {mode}")

    current = wallpaper_dir / "current.jpg"
    current_solid = wallpaper_dir / "colors" / "current.jpg"
    shutil.copyfile(wallpaper, current)
    shutil.copyfile(wallpaper, current_solid)

    screenlayout_script = Path.home() / ".screenlayout/set-screens.sh"

    if not screenlayout_script.exists():
        raise FileNotFoundError(
            f"Screen layout script not found: {screenlayout_script}"
        )

    subprocess.run(
        [str(screenlayout_script)],
        check=True,
    )

    print(f"Wallpaper set: {mode} → {current}")


def set_color_scheme() -> None:
    subprocess.run(["nwg-look"], check=True)


def rebuild_bat_cache() -> None:
    subprocess.run(["bat", "cache", "--build"], check=True)
    print("bat cache rebuilt")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("-t", "--theme", help="Theme name, or 'ls' to list themes")
    args = parser.parse_args()

    if args.theme:
        if args.theme == "ls":
            list_themes()
        else:
            apply_theme(args.theme)
        return

    mode = toggle_bashrc()
    toggle_nvim()
    toggle_vim()
    toggle_emacs()
    restart_emacs_daemon()
    toggle_alacritty()
    toggle_dunst()
    toggle_i3()
    toggle_zathura()
    toggle_rofi()
    toggle_opencode(mode)

    set_wallpaper(mode)
    set_color_scheme()
    rebuild_bat_cache()


if __name__ == "__main__":
    main()
