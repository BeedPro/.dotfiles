#!/usr/bin/env python3
import argparse
import json
import re
import shutil
import subprocess
from pathlib import Path


def _config_roots() -> list[Path]:
    candidates = [Path.home() / ".config", Path.home() / ".dotfiles/.config"]
    return [p for p in candidates if p.exists()]


