#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  printf 'Usage: %s <kdbx-path> [max-backups]\n' "${0##*/}" >&2
  printf 'Example: %s @Databases/Passwords.kdbx 15\n' "${0##*/}" >&2
  exit 1
fi

input_path="$1"
max_backups="${2:-15}"

if ! [[ "$max_backups" =~ ^[1-9][0-9]*$ ]]; then
  printf 'max-backups must be a positive integer, got: %s\n' "$max_backups" >&2
  exit 1
fi

if [[ "$input_path" == @* ]]; then
  input_path="${PWD}/${input_path#@}"
fi

if [ ! -f "$input_path" ]; then
  printf 'Source file not found: %s\n' "$input_path" >&2
  exit 1
fi

filename="$(basename -- "$input_path")"
dbname="${filename%.kdbx}"

if [ "$dbname" = "$filename" ]; then
  printf 'Expected a .kdbx file, got: %s\n' "$filename" >&2
  exit 1
fi

parent_dir="$(dirname -- "$input_path")"
base_dir="$(dirname -- "$parent_dir")"
backup_dir="${base_dir}/Backups/${dbname}"
timestamp="$(date +%Y%m%d%H%M%S)"
target_path="${backup_dir}/${timestamp}.kdbx"

mkdir -p "$backup_dir"
cp -- "$input_path" "$target_path"

printf 'Backup created: %s\n' "$target_path"

mapfile -t backup_files < <(ls -1 "$backup_dir"/*.kdbx 2>/dev/null | sort)
backup_count="${#backup_files[@]}"

if [ "$backup_count" -gt "$max_backups" ]; then
  delete_count=$((backup_count - max_backups))
  for ((i = 0; i < delete_count; i++)); do
    rm -f -- "${backup_files[$i]}"
    printf 'Deleted old backup: %s\n' "${backup_files[$i]}"
  done
fi
