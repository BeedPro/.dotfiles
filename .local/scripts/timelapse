#!/usr/bin/env python3
"""Create a timelapse from a video using ffmpeg."""

import argparse
import subprocess
import sys
from pathlib import Path
from typing import Sequence


DEFAULT_SPEED = 15.0
DEFAULT_FPS = 30


def usage() -> str:
    return """Usage:
  timelapse INPUT [-o OUTPUT] [-f FPS] [-d SECONDS] [-s SPEED]

Create a timelapse from a video using ffmpeg.

Arguments:
  INPUT                 Input video file path.

Options:
  -o, --output PATH     Output file path.
        Default: Timelapses/<input-filename>
  -f, --fps FPS         Output FPS (default: 30).
  -d, --duration SEC    Target timelapse duration in seconds.
        Uses ffprobe to compute speed.
  -s, --speed FACTOR    Timelapse speed factor (default: 15).
        Example: 15 means 15x faster.
  -h, --help            Show this help.

Notes:
  - You can set either --duration or --speed.
  - If both are omitted, speed defaults to 15x.
"""


def print_usage() -> None:
    print(usage(), end="")


def fail(message: str, show_usage: bool = False) -> None:
    print(f"Error: {message}", file=sys.stderr)

    if show_usage:
        print_usage()

    sys.exit(1)


def positive_float(value: str, name: str) -> float:
    try:
        number = float(value)
    except ValueError:
        fail(f"{name} must be a number: {value}")

    if number <= 0:
        fail(f"{name} must be greater than 0.")

    return number


def positive_int(value: str, name: str) -> int:
    try:
        number = int(value)
    except ValueError:
        fail(f"{name} must be an integer: {value}")

    if number <= 0:
        fail(f"{name} must be greater than 0.")

    return number


def parser() -> argparse.ArgumentParser:
    arg_parser = argparse.ArgumentParser(
        add_help=False,
        usage=argparse.SUPPRESS,
    )
    arg_parser.add_argument("input", nargs="?")
    arg_parser.add_argument("-o", "--output")
    arg_parser.add_argument("-f", "--fps", default=str(DEFAULT_FPS))
    arg_parser.add_argument("-d", "--duration")
    arg_parser.add_argument("-s", "--speed")
    arg_parser.add_argument("-h", "--help", action="store_true")
    return arg_parser


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    if not argv:
        print_usage()
        sys.exit(1)

    args, extras = parser().parse_known_args(argv)

    if args.help:
        print_usage()
        sys.exit(0)

    if extras:
        fail(f"unexpected extra argument: {extras[0]}", show_usage=True)

    return args


def input_path(value: str | None) -> Path:
    if value is None:
        fail("INPUT is required.", show_usage=True)

    path = Path(value)

    if not path.is_file():
        fail(f"input file not found: {path}")

    return path


def output_path(input_file: Path, value: str | None) -> Path:
    if value is None:
        directory = Path("Timelapses")
        directory.mkdir(parents=True, exist_ok=True)
        return directory / input_file.name

    path = Path(value)
    path.parent.mkdir(parents=True, exist_ok=True)
    return path


def ffprobe_duration(input_file: Path) -> float:
    command = [
        "ffprobe",
        "-v",
        "error",
        "-show_entries",
        "format=duration",
        "-of",
        "default=nw=1:nk=1",
        str(input_file),
    ]
    result = subprocess.run(
        command,
        text=True,
        capture_output=True,
        check=True,
    )
    output = result.stdout.strip()

    if not output:
        fail("failed to read input duration with ffprobe.")

    return float(output)


def speed_factor(
    input_file: Path,
    duration: str | None,
    speed: str | None,
) -> float:
    if duration is not None and speed is not None:
        fail("use either --duration or --speed, not both.")

    if duration is not None:
        input_duration = ffprobe_duration(input_file)
        return input_duration / positive_float(duration, "duration")

    if speed is not None:
        return positive_float(speed, "speed")

    return DEFAULT_SPEED


def ffmpeg_command(
    input_file: Path,
    output_file: Path,
    speed: float,
    fps: int,
) -> list[str]:
    return [
        "ffmpeg",
        "-i",
        str(input_file),
        "-filter:v",
        f"setpts=PTS/{speed:g},fps={fps}",
        "-an",
        str(output_file),
    ]


def main(argv: Sequence[str] = sys.argv[1:]) -> int:
    args = parse_args(argv)
    source = input_path(args.input)
    target = output_path(source, args.output)
    fps = positive_int(args.fps, "fps")
    speed = speed_factor(source, args.duration, args.speed)

    subprocess.run(ffmpeg_command(source, target, speed, fps), check=True)
    print(f"Created timelapse: {target}")
    print(f"Speed factor: {speed:g}x, FPS: {fps}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
