#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    printf 'Usage: %s <file-path> [max-backups]\n' "${0##*/}" >&2
    printf 'Example: %s @Documents/notes.txt 15\n' "${0##*/}" >&2
    exit 1
fi

input_path="$1"
max_backups="${2:-15}"

if ! [[ "$max_backups" =~ ^[1-9][0-9]*$ ]]; then
    printf 'max-backups must be a positive integer, got: %s\n' "$max_backups" >&2
    exit 1
fi

[[ "$input_path" == @* ]] && input_path="${PWD}/${input_path#@}"

if [ ! -f "$input_path" ]; then
    printf 'Source file not found: %s\n' "$input_path" >&2
    exit 1
fi

filename="$(basename -- "$input_path")"
name_root="${filename%.*}"
extension="${filename##*.}"

[ "$name_root" = "$filename" ] && extension=""

[ -z "$name_root" ] && name_root="backup"

extension_dir="$extension"
[ -z "$extension_dir" ] && extension_dir="noext"

backup_dir="$HOME/.local/state/file-backups/${extension_dir}/${name_root}"
timestamp="$(date +%Y%m%d%H%M%S)"
[ -n "$extension" ] && target_path="${backup_dir}/${timestamp}.${extension}" || target_path="${backup_dir}/${timestamp}"

mkdir -p "$backup_dir"
cp -- "$input_path" "$target_path"

printf '[%s] Created: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$target_path"

mapfile -t backup_files < <(ls -1 "$backup_dir"/* 2>/dev/null | sort)
backup_count="${#backup_files[@]}"

if [ "$backup_count" -gt "$max_backups" ]; then
    delete_count=$((backup_count - max_backups))
    for ((i = 0; i < delete_count; i++)); do
        rm -f -- "${backup_files[$i]}"
        printf '[%s] Deleted: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${backup_files[$i]}"
    done
fi
