#!/usr/bin/env python3

from __future__ import annotations

import curses
import os
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from subprocess import CompletedProcess
from typing import Sequence


@dataclass(frozen=True)
class AppConfig:
    prompt: str
    exit_signal: str
    src_dir: Path


CONFIG = AppConfig(
    prompt="Name: ",
    exit_signal="__ESC_EXIT__",
    src_dir=Path.home() / "Projects",
)

GIT_URL_RE = re.compile(r"^(https?://|git@[^:]+:|ssh://git@[^/]+/|gh:)")
REPO_CLEAN_PATTERNS: Sequence[tuple[str, str]] = (
    (r"^ssh://git@[^/]+/", ""),
    (r"^git@[^:]+:", ""),
    (r"^https?://[^/]+/", ""),
    (r"(\.git)?$", ""),
)


def is_esc(ch: int) -> bool:
    return ch in (27, curses.KEY_EXIT)


def move_left(pos: int) -> int:
    return max(0, pos - 1)


def move_right(pos: int, buf_len: int) -> int:
    return min(buf_len, pos + 1)


def backspace(buf: list[str], pos: int) -> int:
    if pos > 0:
        del buf[pos - 1]
        return pos - 1
    return pos


def delete(buf: list[str], pos: int) -> int:
    if pos < len(buf):
        del buf[pos]
    return pos


def insert_char(buf: list[str], pos: int, ch: int) -> int:
    if 32 <= ch <= 126:
        buf.insert(pos, chr(ch))
        return pos + 1
    return pos


def render_line(
    stdscr,
    prompt: str,
    buf: list[str],
    pos: int,
    error_message: str = "",
) -> None:
    stdscr.move(0, 0)
    stdscr.clrtoeol()
    stdscr.addstr(0, 0, f"{prompt}{''.join(buf)}")

    stdscr.move(1, 0)
    stdscr.clrtoeol()
    if error_message:
        stdscr.addstr(1, 0, error_message)

    stdscr.move(0, len(prompt) + pos)
    stdscr.refresh()


def handle_key(
    ch: int,
    buf: list[str],
    pos: int,
) -> tuple[list[str], int, bool]:
    if is_esc(ch):
        return buf, pos, True

    if ch in (10, 13):
        return buf, pos, True

    if ch == curses.KEY_LEFT:
        return buf, move_left(pos), False

    if ch == curses.KEY_RIGHT:
        return buf, move_right(pos, len(buf)), False

    if ch in (curses.KEY_BACKSPACE, 127):
        return buf, backspace(buf, pos), False

    if ch == curses.KEY_DC:
        return buf, delete(buf, pos), False

    return buf, insert_char(buf, pos, ch), False


def curses_loop(
    stdscr,
    prompt: str,
    initial_value: str = "",
    error_message: str = "",
) -> str:
    curses.set_escdelay(25)
    curses.curs_set(1)
    curses.start_color()
    curses.use_default_colors()

    stdscr.keypad(True)
    stdscr.bkgd(" ", curses.A_NORMAL)

    buf: list[str] = list(initial_value)
    pos = len(buf)
    render_line(stdscr, prompt, buf, pos, error_message)

    while True:
        ch = stdscr.getch()

        buf, pos, done = handle_key(ch, buf, pos)

        render_line(stdscr, prompt, buf, pos, error_message)

        if done:
            if is_esc(ch):
                return CONFIG.exit_signal
            return "".join(buf)


def curses_input(
    prompt: str,
    initial_value: str = "",
    error_message: str = "",
) -> str:
    return curses.wrapper(curses_loop, prompt, initial_value, error_message)


def run(cmd: list[str], check: bool = True) -> CompletedProcess[bytes]:
    return subprocess.run(cmd, check=check)


def ensure_src_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)


def has_session(name: str) -> bool:
    result = subprocess.run(
        ["tmux", "has-session", "-t", name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def ensure_session(name: str, directory: Path | None = None) -> None:
    inside_tmux = "TMUX" in os.environ

    if not has_session(name):
        cmd = ["tmux", "new-session", "-ds", name]
        if directory:
            cmd += ["-c", str(directory)]
        run(cmd)

    if inside_tmux:
        run(["tmux", "switch-client", "-t", name])
    else:
        run(["tmux", "attach-session", "-t", name])


def is_git_url(value: str) -> bool:
    return bool(GIT_URL_RE.match(value))


def clean_repo_path(url: str) -> str:
    cleaned = url
    for pattern, replacement in REPO_CLEAN_PATTERNS:
        cleaned = re.sub(pattern, replacement, cleaned)
    return cleaned


def is_tmp_path(value: str) -> bool:
    return value.startswith("tmp/")


def tmp_target_dir(value: str) -> Path | None:
    relative = value[len("tmp/") :].strip("/")
    if not relative:
        return None
    return Path("/tmp") / relative


def is_share_path(value: str) -> bool:
    return value.startswith("share/")


def share_target_dir(value: str) -> Path | None:
    relative = value[len("share/") :].strip("/")
    if not relative:
        return None
    return Path.home() / ".local" / "share" / relative


def normalize_session_name(value: str) -> str:
    return value.replace(".", "_")


def main() -> None:
    ensure_src_dir(CONFIG.src_dir)
    initial_value = ""
    error_message = ""

    while True:
        value = curses_input(CONFIG.prompt, initial_value, error_message).strip()
        error_message = ""

        if value == CONFIG.exit_signal:
            return

        if not value:
            return

        if is_tmp_path(value):
            tmp_dir = tmp_target_dir(value)
            if tmp_dir is None:
                return

            tmp_dir.mkdir(parents=True, exist_ok=True)
            ensure_session(normalize_session_name(value), tmp_dir)
            return

        if is_share_path(value):
            share_dir = share_target_dir(value)
            if share_dir is None or not share_dir.is_dir():
                initial_value = value
                error_message = "Path not found in ~/.local/share; fix and retry."
                continue

            ensure_session(normalize_session_name(value), share_dir)
            return

        if is_git_url(value):
            clean = clean_repo_path(value)
            repo_dir = CONFIG.src_dir / clean

            if not (repo_dir / ".git").is_dir():
                repo_dir.parent.mkdir(parents=True, exist_ok=True)
                run(["git", "clone", value, str(repo_dir)])

            ensure_session(normalize_session_name(clean), repo_dir)
            return

        session_name = normalize_session_name(value)
        cwd = Path.cwd()

        ensure_session(session_name, cwd)
        return


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)
