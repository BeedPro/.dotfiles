#!/bin/bash
set -euo pipefail

sudo apt purge -y qemu-kvm qemu-system qemu-utils python3-pip libvirt-clients \
  libvirt-daemon-system bridge-utils virtinst libvirt-daemon virt-manager || true
sudo apt autoremove -y

sudo gpasswd -d "$USER" libvirt || true
sudo gpasswd -d "$USER" libvirt-qemu || true
sudo gpasswd -d "$USER" kvm || true
sudo gpasswd -d "$USER" input || true
sudo gpasswd -d "$USER" disk || true

echo "Removed QEMU/libvirt packages from add/qemu"
