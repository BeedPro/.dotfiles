#!/usr/bin/env bash
set -euo pipefail

remove_cronjob() {
  local match="$1"
  local tmp_file

  tmp_file="$(mktemp)"

  if crontab -l >"$tmp_file" 2>/dev/null; then
    grep -vF "$match" "$tmp_file" >"${tmp_file}.next" || true
    crontab "${tmp_file}.next"
    rm -f "$tmp_file" "${tmp_file}.next"
    printf 'Removed cron entries matching: %s\n' "$match"
  else
    rm -f "$tmp_file"
    printf 'No crontab found for current user.\n'
  fi
}

remove_keepass_backup_cron() {
  local tag="# keepass-backup-hourly"
  local script_path="$HOME/.local/scripts/keepass-backup"

  remove_cronjob "$tag"
  remove_cronjob "$script_path"
}

remove_keepass_backup_cron
