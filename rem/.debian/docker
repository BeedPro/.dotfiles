#!/bin/bash
set -euo pipefail

sudo apt purge -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin || true
sudo apt autoremove -y

if command -v extrepo >/dev/null 2>&1; then
  sudo extrepo disable docker-ce || true
fi

sudo rm -f /etc/apt/sources.list.d/docker.sources
sudo rm -f /etc/apt/sources.list.d/docker.sources.disabled
sudo rm -f /etc/apt/keyrings/docker.asc
sudo apt update

echo "Removed Docker packages and apt source"
