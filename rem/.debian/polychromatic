#!/bin/bash
set -euo pipefail

sudo apt purge -y polychromatic openrazer-meta || true
sudo apt autoremove -y

sudo rm -f /etc/apt/sources.list.d/polychromatic.list
sudo rm -f /usr/share/keyrings/polychromatic.gpg
sudo apt update

sudo gpasswd -d "$USER" plugdev || true

echo "Removed Polychromatic and OpenRazer packages"
