#!/bin/bash
set -euo pipefail

if command -v cargo >/dev/null 2>&1; then
  cargo uninstall typst-cli || true
  cargo uninstall tinymist-cli || true
  cargo uninstall prettypst || true
fi

sudo rm -f /usr/local/bin/tinymist
sudo rm -f /usr/local/bin/prettypst

sudo apt purge -y pkg-config libssl-dev || true
sudo apt autoremove -y

echo "Removed Typst toolchain from add/typst"
