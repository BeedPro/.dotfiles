#!/bin/bash
set -euo pipefail

sudo systemctl disable --now wg-quick@wg0 2>/dev/null || true

sudo apt purge -y wireguard wireguard-tools || true
sudo apt autoremove -y

printf '%s\n' \
  'WireGuard removed.' \
  '' \
  'Note:' \
  '- /etc/wireguard/wg0.conf was not removed.' \
  '- Delete it manually if you no longer need the VPN config.'
