#!/usr/bin/env bash
set -euo pipefail

CORE_UTILS=(
  bash-completion tmux vim git curl stow eza bat fd-find ripgrep du-dust git-lfs
  python3-venv pipx rofi qalc alacritty
)

SYSTEM=(
  acpi brightnessctl pulseaudio-utils libnotify-bin network-manager network-manager-applet
  lxpolkit aspell aspell-en fonts-noto fonts-noto-color-emoji
)

X11_TOOLS=(picom feh xss-lock dunst nwg-look maim x11-xkb-utils xclip xdotool)
MEDIA=(mpd mpc mpv nsxiv zathura xournalpp libavcodec-extra farbfeld)
THEME=(adwaita-qt arc-theme papirus-icon-theme)

sudo apt purge -y "${CORE_UTILS[@]}" "${SYSTEM[@]}" "${X11_TOOLS[@]}" "${MEDIA[@]}" "${THEME[@]}" || true
sudo apt autoremove -y

if command -v extrepo >/dev/null 2>&1; then
  sudo extrepo disable debian_backports || true
fi

sudo rm -f /etc/apt/sources.list.d/debian-backports.sources
sudo rm -f /etc/apt/sources.list.d/debian-backports.sources.disabled

if [ -L /usr/local/bin/bat ]; then
  sudo rm -f /usr/local/bin/bat
fi

if [ -L /usr/local/bin/fd ]; then
  sudo rm -f /usr/local/bin/fd
fi

echo "Removed packages installed by add/apt"
