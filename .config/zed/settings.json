{
  "edit_predictions": {
    "mode": "subtle",
  },
  "disable_ai": false,
  "agent": {
    "single_file_review": false,
    "favorite_models": [],
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
      "enable_thinking": false,
    },
    "model_parameters": [],
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "never",
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
    "highlight_on_yank_duration": 200,
  },
  "preferred_line_length": 80,
  "soft_wrap": "none",
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true,
  },
  "scroll_beyond_last_line": "off",
  "vertical_scroll_margin": 0,
  "format_on_save": "on",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Kanso Pearl (No italics)",
    "dark": "Kanso Zen (No italics)",
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "languages": {
    "Lua": {
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": ["--stdin-filepath", "{buffer_path}", "-"],
        },
      },
    },
    "Typst": {
      "formatter": {
        "external": {
          "command": "prettypst",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "Python": {
      "formatter": "ruff",
    },
    "HTML (Django)": {
      "formatter": {
        "external": {
          "command": "djlint",
          "arguments": ["--reformat", "--quiet", "-"],
        },
      },
    },
    "Django HTML": {
      "formatter": {
        "external": {
          "command": "djlint",
          "arguments": ["--reformat", "--quiet", "-"],
        },
      },
    },
    "HTML": {
      "formatter": {
        "external": {
          "command": "biome",
          "arguments": ["format", "--stdin-file-path", "{buffer_path}"],
        },
      },
    },
    "CSS": {
      "formatter": {
        "external": {
          "command": "biome",
          "arguments": ["format", "--stdin-file-path", "{buffer_path}"],
        },
      },
    },
    "Markdown": {
      "formatter": {
        "external": {
          "command": "prettierd",
          "arguments": ["{buffer_path}"],
        },
      },
    },
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "biome",
          "arguments": ["format", "--stdin-file-path", "{buffer_path}"],
        },
      },
    },
    "JSX": {
      "formatter": {
        "external": {
          "command": "biome",
          "arguments": ["format", "--stdin-file-path", "{buffer_path}"],
        },
      },
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "biome",
          "arguments": ["format", "--stdin-file-path", "{buffer_path}"],
        },
      },
    },
    "TSX": {
      "formatter": {
        "external": {
          "command": "biome",
          "arguments": ["format", "--stdin-file-path", "{buffer_path}"],
        },
      },
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "biome",
          "arguments": ["format", "--stdin-file-path", "{buffer_path}"],
        },
      },
    },
    "Svelte": {
      "formatter": {
        "external": {
          "command": "biome",
          "arguments": ["format", "--stdin-file-path", "{buffer_path}"],
        },
      },
    },
    "C": {
      "formatter": {
        "external": {
          "command": "clang-format",
          "arguments": ["--assume-filename", "{buffer_path}"],
        },
      },
    },
    "C++": {
      "formatter": {
        "external": {
          "command": "clang-format",
          "arguments": ["--assume-filename", "{buffer_path}"],
        },
      },
      "format_on_save": "off",
    },
    "GDScript": {
      "formatter": {
        "external": {
          "command": "gdformat",
          "arguments": ["-"],
        },
      },
    },
  },
}
