set $mod Mod4
set $browser firefox
set $files thunar

font pango:CommitMono Nerd Font Mono 12

include ~/.config/i3/themes/dark.conf

exec --no-startup-id ~/.local/share/autostart

workspace 1 output DP-4 eDP
workspace 2 output DP-4 eDP
workspace 3 output DP-4 eDP
workspace 4 output DP-4 eDP
workspace 5 output DP-4 eDP
workspace 6 output DP-4 eDP
workspace 7 output DP-4 eDP
workspace 8 output DP-4 eDP
workspace 9 output DP-4 eDP
workspace 10 output DP-0 HDMI-A-0

gaps inner 0
gaps outer 0

focus_wrapping workspace

set $chat_ws 7
set $no_private ^(?!.*Private Browsing)

for_window [class="^Firefox$" title="$no_private.*WhatsApp.*"] move --no-auto-back-and-forth to workspace number $chat_ws
for_window [class="^Firefox$" title="$no_private.*Discord.*"] move --no-auto-back-and-forth to workspace number $chat_ws
for_window [class="^Firefox$" title="$no_private.*Element.*"] move --no-auto-back-and-forth to workspace number $chat_ws
for_window [class="^Firefox$" title="$no_private.*Google Messages.*"] move --no-auto-back-and-forth to workspace number $chat_ws

set $email_ws 8

for_window [class=Firefox title=".*Gmail.*"] move --no-auto-back-and-forth to workspace number $email_ws
for_window [class=Firefox title=".*Outlook.*"] move --no-auto-back-and-forth to workspace number $email_ws

assign [class="KeePassXC"] number 9
assign [class="protonvpn-app"] number 9

default_border normal 1
default_floating_border normal 1
hide_edge_borders smart_no_gaps

for_window [title="^floating$"] floating enable
for_window [class="^floating$"] floating enable
for_window [instance="^floating$"] floating enable

floating_modifier $mod
tiling_drag modifier titlebar

bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86MonBrightnessUp   exec --no-startup-id ~/.local/scripts/brightness up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.local/scripts/brightness down
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.local/scripts/volume up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.local/scripts/volume down
bindsym XF86AudioMute exec --no-startup-id ~/.local/scripts/volume mute
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym $mod+F12 exec --no-startup-id ~/.local/scripts/xswapkb
bindsym Print exec --no-startup-id ~/.local/scripts/screenshot selection
bindsym $mod+Print exec --no-startup-id ~/.local/scripts/screenshot screen --full-screen --no-save --no-notify
bindsym $mod+Shift+Print exec --no-startup-id ~/.local/scripts/screenshot everything --show
bindsym $mod+control+Print exec --no-startup-id ~/.local/scripts/screenshot window --show
bindsym $mod+Tab workspace back_and_forth
bindsym $mod+Left workspace prev
bindsym $mod+Right workspace next
bindsym $mod+Shift+Left move container to workspace prev
bindsym $mod+Shift+Right move container to workspace next

bindsym $mod+e exec --no-startup-id $files
bindsym $mod+n exec --no-startup-id emacsclient -c -s default

bindsym $mod+Return exec --no-startup-id alacritty
bindsym $mod+w exec --no-startup-id $browser
bindsym $mod+Shift+w exec --no-startup-id ~/.local/scripts/bookmarks

bindsym $mod+x exec --no-startup-id i3lock --pass-volume-keys --pass-media-keys -c "#000000"

bindsym $mod+Shift+x exec --no-startup-id ~/.local/scripts/powermenu
bindsym $mod+Shift+c exec --no-startup-id ~/.local/scripts/killmenu

bindsym $mod+c kill

bindsym $mod+space exec --no-startup-id rofi -show drun

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+control+h resize shrink width 5 px or 5 ppt
bindsym $mod+control+j resize grow height 5 px or 5 ppt
bindsym $mod+control+k resize shrink height 5 px or 5 ppt
bindsym $mod+control+l resize grow width 5 px or 5 ppt

bindsym $mod+b split h
bindsym $mod+v split v

bindsym $mod+m fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+t layout tabbed
bindsym $mod+g layout toggle split

bindsym $mod+Shift+f floating toggle

bindsym $mod+f focus mode_toggle

bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 scratchpad show

bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move scratchpad
bindsym $mod+Shift+minus floating toggle, sticky toggle

bindsym $mod+comma focus output left
bindsym $mod+period focus output right

bindsym $mod+Shift+comma move container to output left
bindsym $mod+Shift+period move container to output right

bindsym $mod+Mod1+b bar mode toggle
bindsym $mod+Mod1+r reload
bindsym $mod+Mod1+t exec --no-startup-id "~/.local/scripts/teme --confirm
bindsym $mod+Mod1+Shift+r restart
bindsym $mod+Mod1+c exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"
