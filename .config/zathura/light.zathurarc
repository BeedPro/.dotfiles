# Light
# Theme: Light
set notification-error-bg       "#ffffff"
set notification-error-fg       "#a60000"
set notification-warning-bg     "#ffffff"
set notification-warning-fg     "#6f5500"
set notification-bg             "#ffffff"
set notification-fg             "#000000"

set completion-bg               "#ffffff"
set completion-fg               "#000000"
set completion-group-bg         "#ffffff"
set completion-group-fg         "#000000"
set completion-highlight-bg     "#c0deff"
set completion-highlight-fg     "#000000"

set index-bg                    "#ffffff"
set index-fg                    "#595959"
set index-active-bg             "#e0e0e0"
set index-active-fg             "#0a0a0a"

set inputbar-bg                 "#ffffff"
set inputbar-fg                 "#000000"

set statusbar-bg                "#ffffff"
set statusbar-fg                "#000000"

set highlight-color             "#80006800"
set highlight-active-color      "#80a60000"

set default-bg                  "#ffffff"
set default-fg                  "#000000"
set render-loading              "true"
set render-loading-bg           "#ffffff"
set render-loading-fg           "#000000"

set recolor-lightcolor          "#ffffff"
set recolor-darkcolor           "#000000"
set recolor                     "true"
