#!/bin/sh

rofi_select() {
  prompt="$1"
  printf "%s\n" "$2" | rofi -dmenu -i -p "$prompt"
}

rofi_input() {
  prompt="$1"
  initial="$2"
  printf "%s" "$initial" | rofi -dmenu -p "$prompt"
}

copy_to_clipboard() {
  kind="$1"
  payload="$2"
  wayland_msg="$3"
  x11_msg="$4"

  if [ -n "$WAYLAND_DISPLAY" ] && command -v wl-copy >/dev/null; then
    if [ "$kind" = "file" ]; then
      wl-copy < "$payload" && notify-send -i "$payload" "$wayland_msg"
    else
      printf "%s\n" "$payload" | wl-copy && notify-send "$wayland_msg"
    fi
  elif command -v xclip >/dev/null; then
    if [ "$kind" = "file" ]; then
      xclip -selection clipboard -t image/png -i "$payload" && notify-send -i "$payload" "$x11_msg"
    else
      printf "%s\n" "$payload" | xclip -selection clipboard && notify-send "$x11_msg"
    fi
  else
    notify-send "Clipboard tool not found (xclip or wl-copy)."
  fi
}

if ! command -v rofi >/dev/null 2>&1; then
  notify-send "rofi is not installed."
  exit 1
fi

while read -r file; do
  case "$file" in
    /*) fullpath="$file" ;;
    *) fullpath="$(pwd)/$file" ;;
  esac

  case "$1" in
    "w")
      cp "$file" "$HOME/.config/wallpaper/current.jpg" &&
      $HOME/.screenlayout/screens.sh
      notify-send -i "$HOME/.config/wallpaper/current.jpg" "Wallpaper changed."
      ;;

    "C-d")
      confirm="$(rofi_select "Really delete $file?" "No
Yes")"
      if [ "$confirm" = "Yes" ]; then
        rm "$file" && notify-send "$file deleted."
      fi
      ;;

    "C-c")
      copy_to_clipboard "file" "$file" "Image copied to clipboard (Wayland)" "Image copied to clipboard (X11)"
      ;;

    "C-r")
      magick "$file" -rotate 90 "$file"
      ;;

    "y")
      copy_to_clipboard "text" "$fullpath" "File path copied to clipboard (Wayland)" "File path copied to clipboard (X11)"
      ;;

    "r")
      current_name="$(basename "$file")"
      dir_name="$(dirname "$file")"
      new_name="$(rofi_input "Rename to" "$current_name")"

      if [ -n "$new_name" ]; then
        mv -- "$file" "$dir_name/$new_name" && notify-send -i "$dir_name/$new_name" "Renamed to $new_name"
      fi
      ;;

    "s")
      case "$fullpath" in
        /tmp/*)
          if command -v "$HOME/.local/scripts/dbrowse" >/dev/null; then
            target_dir="$("$HOME/.local/scripts/dbrowse")"
            if [ -n "$target_dir" ]; then
              new_name="$(rofi_input "Save as" "$(basename "$file")")"
              [ -n "$new_name" ] && cp -- "$file" "$target_dir/$new_name" && notify-send -i "$target_dir/$new_name" "Saved to $target_dir/$new_name"
            fi
          fi
          ;;
        *)
          notify-send "Save only works for images in /tmp."
          ;;
      esac
      ;;

    "m")
      if command -v "$HOME/.local/scripts/dbrowse" >/dev/null; then
        target_dir="$("$HOME/.local/scripts/dbrowse")"
        [ -n "$target_dir" ] && mv "$file" "$target_dir" && notify-send -i "$file" "Moved to $target_dir"
      fi
      ;;

    "c")
      if command -v "$HOME/.local/scripts/dbrowse" >/dev/null; then
        target_dir="$("$HOME/.local/scripts/dbrowse")"
        [ -n "$target_dir" ] && cp "$file" "$target_dir" && notify-send -i "$file" "Copied to $target_dir"
      fi
      ;;

    "e")
      if command -v thunar >/dev/null; then
        thunar "$file" &
        notify-send -i "$file" "Opened in Thunar"
        kill "$PPID"
        exit 0
      else
        notify-send "Thunar is not installed."
      fi
      ;;

    "i")
      notify-send "File information" "$(mediainfo "$file" | sed "s/[ ]\+:/:/g;s/: /: <b>/;s/$/<\/b>/" | grep "<b>")"
      ;;

    *)
      notify-send "Unknown action: $1"
      ;;
  esac
done
