#!/bin/sh

DIVIDER_FILE="$HOME/.config/i3blocks/divider"
if [ -r "$DIVIDER_FILE" ]; then
    IFS= read -r DIVIDER < "$DIVIDER_FILE"
fi

format_output() {
    if [ -n "$DIVIDER" ]; then
        printf '%s %s\n' "$DIVIDER" "$1"
    else
        printf '%s\n' "$1"
    fi
}

MEM=$(free 2>/dev/null | awk '$1 == "Mem:" { printf "%02d%%", ($3 / $2) * 100 }')

[ -n "$MEM" ] || exit 0

format_output "RAM $MEM"
