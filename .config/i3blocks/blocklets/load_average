#!/bin/sh

DIVIDER_FILE="$HOME/.config/i3blocks/divider"
if [ -r "$DIVIDER_FILE" ]; then
    IFS= read -r DIVIDER < "$DIVIDER_FILE"
fi

format_output() {
    if [ -n "$DIVIDER" ]; then
        printf '%s %s\n' "$DIVIDER" "$1"
    else
        printf '%s\n' "$1"
    fi
}

read -r LOAD _ < /proc/loadavg || exit 0
[ -n "$LOAD" ] || exit 0
CORES=$(getconf _NPROCESSORS_ONLN 2>/dev/null)
[ -n "$CORES" ] || exit 0

USAGE=$(awk -v avg="$LOAD" -v cores="$CORES" 'BEGIN { printf "%d%%", (avg / cores) * 100 }')

format_output "CPU $USAGE"
