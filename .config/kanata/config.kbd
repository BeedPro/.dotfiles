(defcfg
  process-unmapped-keys yes
  linux-unicode-u-code v
)

(deflocalkeys-linux
  # 43
  \ 86
  micmute 248
)

(defsrc
  esc       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  prtsc scrlck pause  nlck kp/ kp* kp-
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc ins   home   pgup   kp7  kp8 kp9 kp+
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    ret  del   end    pgdn   kp4  kp5 kp6
  caps a    s    d    f    g    h    j    k    l    ;    '    #                             kp1  kp2 kp3
  lsft \    z    x    c    v    b    n    m    ,    .    /         rsft       up            kp0  kp.     kprt
  lctl lmet lalt           spc                                ralt rctl left  down   right
)

(defvar
  tap-timeout   200
  hold-timeout  200
  tt $tap-timeout
  ht $hold-timeout
)

(defalias
  lyr (layer-while-held layers)
  num (layer-while-held navnums)

  spc (multi f24 (tap-hold $tt $ht spc (layer-while-held symbols)))
  tab (multi f24 (tap-hold $tt $ht tab (layer-while-held navnums)))
  bsc (multi f24 (tap-hold $tt $ht bspc (layer-while-held functions)))

  a (multi f24 (tap-hold $tt $ht a lmet))
  s (multi f24 (tap-hold $tt $ht s lalt))
  d (multi f24 (tap-hold $tt $ht d lsft))
  f (multi f24 (tap-hold $tt $ht f lctl))

  j (multi f24 (tap-hold $tt $ht j rctl))
  k (multi f24 (tap-hold $tt $ht k rsft))
  l (multi f24 (tap-hold $tt $ht l lalt))
  ; (multi f24 (tap-hold $tt $ht ; rmet))
)

(deflayer base
  @lyr      XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX    XX     XX     XX   XX  XX  XX
  XX   q    w    e    r    t    XX   y    u    i    o    p    XX   XX   XX    XX     XX     XX   XX  XX  XX
  XX   @a   @s   @d   @f   g    XX   h    @j   @k   @l   @;   XX   XX   XX    XX     XX     XX   XX  XX
  XX   z    x    c    v    b    XX   n    m    ,    .    /    XX                            XX   XX  XX
  XX   XX   XX   XX   @num @spc @bsc ret  @tab esc  XX   XX             XX    XX            XX   XX      XX
  XX   XX   XX             XX                                 XX   XX   XX    XX     XX
)

(defalias
  sym (layer-while-held symbols)

  fsp (multi f24 (tap-hold $tt $ht spc (layer-while-held functions)))
)

(deflayer navnums
  XX         XX     XX   XX   XX   XX   XX   XX    XX    XX   XX   XX   XX   XX    XX     XX     XX   XX  XX  XX
  XX   1     2      3    4    5    XX   pp   prtsc del   ins  caps XX   XX   XX    XX     XX     XX   XX  XX  XX
  @sym 6     7      8    9    0    XX   left down  up    rght esc  XX   XX   XX    XX     XX     XX   XX  XX
  lmet brdwn voldwn volu bru  mute XX   home pgdn  pgup  end  XX   XX                            XX   XX  XX
  XX   XX    XX     XX   XX   @fsp XX   XX   XX    XX    XX   XX             XX    XX            XX   XX      XX
  XX   XX    XX               XX                                   XX   XX   XX    XX     XX
)

(defalias
  ftb (multi f24 (tap-hold $tt $ht tab (layer-while-held functions)))
)

(deflayer symbols
  XX        XX    XX    XX   XX   XX   XX   XX   XX   XX   XX    XX   XX   XX    XX     XX     XX   XX  XX  XX
  XX   S-1  S-2   S-3   S-4  S-5  XX   S-=  -    S--  S-,  S-.   XX   XX   XX    XX     XX     XX   XX  XX  XX
  XX   S-6  S-7   S-8   S-9  S-0  XX   =    [    ]    S-[  S-]   XX   XX   XX    XX     XX     XX   XX  XX
  lmet grv  S-grv \     S-\  XX   XX   XX   '    S-'  #    S-#   XX                            XX   XX  XX
  XX   XX   XX    XX    XX   XX   XX   XX   @ftb XX   XX   XX              XX    XX            XX   XX      XX
  XX   XX   XX               XX                                  XX   XX   XX    XX     XX
)


(defalias
  mau (movemouse-accel-up 3 500 1 5)
  mal (movemouse-accel-left 3 500 1 5)
  mad (movemouse-accel-down 3 500 1 5)
  mar (movemouse-accel-right 3 500 1 5)
)

(deflayer functions
  XX        XX   XX   XX   XX   XX   XX      XX      XX    XX   XX   XX   XX   XX    XX     XX     XX   XX  XX  XX
  XX   f1   f2   f3   f4   XX   XX   lctl    mlft    mmid  mrgt lsft XX   XX   XX    XX     XX     XX   XX  XX  XX
  XX   f5   f6   f7   f8   lctl XX   @mal    @mad    @mau  @mar mlft XX   XX   XX    XX     XX     XX   XX  XX
  XX   f9   f10  f11  f12  lsft XX   mwl     mwd     mwu   mwr  XX   XX                            XX   XX  XX
  XX   XX   XX   XX   XX   XX   XX   mlft    mmid    mrgt  XX   XX        XX   XX                  XX   XX      XX
  XX   XX   XX             XX                                   XX   XX   XX   XX    XX
)

(defalias
  yrs (multi f24 (tap-hold $tt $ht esc (layer-while-held layers)))
)

(deflayer qwerty
  @yrs      f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  prtsc scrlck pause  nlck kp/ kp* kp-
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc ins   home   pgup   kp7  kp8 kp9 kp+
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    ret  del   end    pgdn   kp4  kp5 kp6
  caps a    s    d    f    g    h    j    k    l    ;    '    #                             kp1  kp2 kp3
  lsft \    z    x    c    v    b    n    m    ,    .    /         rsft       up            kp0  kp.     kprt
  lctl lmet lalt           spc                                ralt rctl left  down   right
)

(defalias
  qwt (layer-switch qwerty)
)

(deflayer layers
  XX        XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX    XX     XX     XX   XX  XX  XX
  XX   lrld @qwt XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX    XX     XX     XX   XX  XX  XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX    XX     XX     XX   XX  XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX                            XX   XX  XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX             XX    XX            XX   XX      XX
  XX   XX   XX             XX                                 XX   XX   XX    XX     XX
)
