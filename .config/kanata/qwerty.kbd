(defcfg
  process-unmapped-keys yes
  linux-unicode-u-code v
)

(deflocalkeys-linux
  # 43
  \ 86
  micmute 248
)

(defsrc
  esc       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  prtsc scrlck pause  nlck kp/ kp* kp-
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc ins   home   pgup   kp7  kp8 kp9 kp+
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    ret  del   end    pgdn   kp4  kp5 kp6
  caps a    s    d    f    g    h    j    k    l    ;    '    #                             kp1  kp2 kp3
  lsft \    z    x    c    v    b    n    m    ,    .    /         rsft       up            kp0  kp.     kprt
  lctl lmet lalt           spc                                ralt rctl left  down   right
)

(defvar
  tap-timeout   200
  hold-timeout  200
  tt $tap-timeout
  ht $hold-timeout
)

(defalias
  esc (multi f24 (tap-hold $tt $ht esc (layer-while-held funnav)))
)

(deflayer qwerty
  esc       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  prtsc scrlck pause  nlck kp/ kp* kp-
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc ins   home   pgup   kp7  kp8 kp9 kp+
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    ret  del   end    pgdn   kp4  kp5 kp6
  @esc a    s    d    f    g    h    j    k    l    ;    '    #                             kp1  kp2 kp3
  lsft \    z    x    c    v    b    n    m    ,    .    /         rsft       up            kp0  kp.     kprt
  lctl lmet lalt           spc                                ralt rctl left  down   right
)

(deflayer funnav
  XX         XX   XX   XX   XX   XX   XX    XX   XX    XX   XX   XX   XX   XX    XX     XX     XX   XX  XX  XX
  S-grv f1   f2   f3   f4   f5   f6   f7    f8   f9    f10  f11  f12  XX   XX    XX     XX     XX   XX  XX  XX
  grv   XX   XX   XX   XX   XX   XX   prtsc del  ins   caps XX   XX   XX   XX    XX     XX     XX   XX  XX
  XX    XX   XX   XX   XX   XX   left down  up   right XX   XX   XX                            XX   XX  XX
  XX    XX   XX   XX   XX   XX   home pgdn  pgup end   XX   XX             XX    XX            XX   XX      XX
  XX    XX   XX             XX                                   XX   XX   XX    XX     XX
)
