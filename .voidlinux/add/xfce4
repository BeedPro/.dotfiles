#!/usr/bin/env bash

set -euo pipefail

# Lock root account
sudo -v
sudo true
sudo passwd -l root

# System update and repositories
sudo xbps-install -Syu

sudo xbps-install -S \
  void-repo-nonfree \
  void-repo-multilib \
  void-repo-multilib-nonfree \
  linux-firmware

# Desktop packages
sudo xbps-install -S \
  dbus-x11 \
  xorg \
  xfce4 \
  xfce4-plugins \
  xfce4-screenshooter \
  lightdm \
  lightdm-gtk-greeter

# Applications, themes, fonts, and helpers
sudo xbps-install -S \
  firefox \
  yaru \
  papirus-icon-theme \
  dejavu-fonts-ttf \
  noto-fonts-ttf \
  noto-fonts-emoji \
  nerd-fonts \
  font-iosevka \
  gohufont \
  brightnessctl \
  gvfs \
  udisks2

# Desktop permissions and networking
sudo xbps-install -S \
  NetworkManager \
  network-manager-applet

# Audio and Bluetooth
sudo xbps-install -S \
  pipewire \
  wireplumber \
  alsa-pipewire \
  pamixer \
  pavucontrol \
  bluez \
  libspa-bluetooth \
  blueman

# Use dotfiles-managed autostart entries
mkdir -p "$HOME/.config"
ln -sfn "$HOME/.dotfiles/.config/autostart" "$HOME/.config/autostart"

# PipeWire user configuration
mkdir -p "$HOME/.config/pipewire/pipewire.conf.d"
ln -sfn /usr/share/examples/wireplumber/10-wireplumber.conf "$HOME/.config/pipewire/pipewire.conf.d/10-wireplumber.conf"
ln -sfn /usr/share/examples/pipewire/20-pipewire-pulse.conf "$HOME/.config/pipewire/pipewire.conf.d/20-pipewire-pulse.conf"

# ALSA compatibility for PipeWire
sudo mkdir -p /etc/alsa/conf.d
sudo ln -sfn /usr/share/alsa/alsa.conf.d/50-pipewire.conf /etc/alsa/conf.d/50-pipewire.conf
sudo ln -sfn /usr/share/alsa/alsa.conf.d/99-pipewire-default.conf /etc/alsa/conf.d/99-pipewire-default.conf

# Start services after packages and config links are in place
sudo ln -sfn /etc/sv/dbus /var/service/dbus
sudo ln -sfn /etc/sv/elogind /var/service/elogind
sudo ln -sfn /etc/sv/lightdm /var/service/lightdm
sudo ln -sfn /etc/sv/udisks2 /var/service/udisks2
sudo ln -sfn /etc/sv/polkitd /var/service/polkitd
sudo ln -sfn /etc/sv/NetworkManager /var/service/NetworkManager
sudo ln -sfn /etc/sv/bluetoothd /var/service/bluetoothd

# Add user to common desktop groups
sudo usermod -aG wheel,audio,video,input,storage,network,bluetooth "$USER"

# Reboot to apply everything
sudo reboot
