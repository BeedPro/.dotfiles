#!/usr/bin/env bash

set -euo pipefail

sudo xbps-install -Syu
sudo xbps-install -Sy \
  void-repo-nonfree \
  void-repo-multilib \
  void-repo-multilib-nonfree

sudo xbps-install -Syu
sudo xbps-install -Sy \
  linux-headers \
  linux-firmware-nvidia \
  nvidia \
  nvidia-dkms \
  nvidia-libs \
  nvidia-libs-32bit \
  nvidia-gtklibs

printf '%s\n' \
  'Installed NVIDIA drivers from Void repositories.' \
  '' \
  'Reboot after installation so the driver stack is loaded cleanly.'
